// ============================================================
// SMC TM SUPREME v6.0 — Pine Script v6
// MERGED: SMC Pro System v5.0 + TM Supreme7
//
// NEW IN v6.0 vs v5.0:
//   + HTF trend confirmation (EMA200 on HTF)
//   + MSNR zone filter (fresh S/R + rejection + structure)
//   + CTR impulse + mid-retest confirmation
//   + ACCU-LOCK mode (lock trade state for N bars)
//   + 15-point scoring (from Supreme7), SMC components blended in
//   + Protection pad (ATR / Points / %) modes
//   + Macro event filter (FOMC / NFP / CPI / PPI)
//   + Advanced volume pressure (auto-adaptive method)
//   + Market internals (VIX / A-D / SPY-TLT / DXY / BTC)
//   + Reversal exit: pre-SL fast exit + after-TP gate
//   + Safe exit: weak-flow / macro / pad-break / opp-signal
//   + Flip on reversal exit
//   + SMC: pivot-based BOS/CHoCH labels (more reliable than 20-bar)
//   + SMC: Order Block boxes (bull/bear)
//   + SMC: FVG boxes (bull/bear)
//   + SMC: EQH / EQL liquidity levels
//   + SMC: CPR (daily Pivot / TC / BC)
//   + SMC: SOS / MSS with volume confirmation
//   + SMC: Micro-danger window (doji near SL, purple bg)
//   + SMC: Bar color on entry / exit / danger
//   + System health dashboard + rules panel
//   + Liquidity sweep boxes + magnet tags
//
// Designed for: Forex / Crypto / XAU | TF: 3m / 5m / 15m
// Author: Built for Ashbin | No Repaint | Real-Time Alerts
// ============================================================

//@version=6
indicator("SMC TM Supreme v6.1 [Ashbin]", overlay=true,
     max_bars_back=5000, max_lines_count=500,
     max_labels_count=500, max_boxes_count=300)

// ═══════════════════════════════════════════════════════════
// AUTO DETECT
// ═══════════════════════════════════════════════════════════
s_type   = syminfo.type
s_ticker = syminfo.tickerid
b_conf   = barstate.isconfirmed
b_last   = barstate.islast

isAutoCrypto = s_type == "crypto"
isAutoForex  = s_type == "forex"
isAutoNSE    = str.contains(s_ticker, "NSE:")

// ═══════════════════════════════════════════════════════════
// INPUTS — DASHBOARD / THEME
// ═══════════════════════════════════════════════════════════
grpDash = "Dashboard Settings"
dashPos   = input.string("Top Right", "Position", options=["Top Left","Top Right","Bottom Left","Bottom Right","Hidden"], group=grpDash)
dashTheme = input.string("Dark",      "Theme",    options=["Dark","Light","Professional","Neon"],                         group=grpDash)
dashSize  = input.string("Tiny",      "Size",     options=["Tiny","Small"],                                               group=grpDash)
showMainDash  = input.bool(true,  "Show Main Dashboard",  group=grpDash)
showRulesPanel = input.bool(true, "Show Rules Panel",     group=grpDash)

getThemeColors() =>
    switch dashTheme
        "Dark"         => [color.new(#000000,0), color.new(#111111,0), color.lime, color.red, color.aqua, color.fuchsia, color.orange, color.white, color.new(color.white,40)]
        "Light"        => [color.new(#ffffff,30), color.new(#f0f0f0,10), color.new(#00aa00,0), color.new(#ff0000,0), color.new(#0088ff,0), color.new(#8800ff,0), color.new(#ff8800,0), color.black, color.new(color.black,50)]
        "Professional" => [color.new(#1e1e1e,30), color.new(#2d2d2d,10), color.new(#00c851,0), color.new(#ff4444,0), color.new(#33b5e5,0), color.new(#aa66cc,0), color.new(#ffbb33,0), color.white, color.new(color.white,35)]
        =>               [color.new(#0a0a0a,30), color.new(#1a1a1a,10), color.lime, color.red, color.aqua, color.fuchsia, color.yellow, color.white, color.new(color.white,45)]

[c_bg, c_bg_hdr, c_green, c_red, c_blue, c_purple, c_orange, c_text, c_text_m] = getThemeColors()

dash_loc  = switch dashPos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.top_right

d_sz  = dashSize == "Small" ? size.small : size.tiny
showDashboard = showMainDash and dashPos != "Hidden"

// ═══════════════════════════════════════════════════════════
// INPUTS — VISUAL
// ═══════════════════════════════════════════════════════════
grpVis = "Visual Settings"
lineExtBars      = input.int(15,   "Level Lines Extend Bars",    minval=1,  maxval=200, group=grpVis)
showOB           = input.bool(true,"Show Order Blocks",                                 group=grpVis)
showFVG          = input.bool(true,"Show FVG Boxes",                                    group=grpVis)
showLiq          = input.bool(true,"Show EQH / EQL Levels",                             group=grpVis)
showSweepBoxes   = input.bool(true,"Show Liquidity Sweep Boxes",                        group=grpVis)
showMagnetTags   = input.bool(true,"Show Magnet Tags",                                  group=grpVis)
showDeltaTint    = input.bool(false,"Show Delta Tint (Light)",                          group=grpVis)
showBOSLabels    = input.bool(true,"Show BOS / CHoCH Labels",                           group=grpVis)
showCPR          = input.bool(true,"Show CPR (Daily Pivot/TC/BC)",                      group=grpVis)
recentOnlyBars   = input.int(300,  "Draw Only Recent N Bars",    minval=50, maxval=5000, group=grpVis)

// ═══════════════════════════════════════════════════════════
// INPUTS — SMC SETTINGS
// ═══════════════════════════════════════════════════════════
grpSMC = "SMC Settings"
ms_len  = input.int(10, "Structure Swing Length", group=grpSMC)
ob_len  = input.int(5,  "Order Block Lookback",   group=grpSMC)
liq_tol_mult = input.float(0.15, "EQH/EQL ATR Tolerance", step=0.05, group=grpSMC)

// ═══════════════════════════════════════════════════════════
// INPUTS — REVERSAL EXIT
// ═══════════════════════════════════════════════════════════
grpRev = "Reversal Exit"
exitOnOppSignal      = input.bool(true,  "Exit on Opposite Signal",         group=grpRev)
showRevArea          = input.bool(true,  "Show Reversal Exit Area",          group=grpRev)
revExitBoxBars       = input.int(8,      "Exit Area Width (bars)",           group=grpRev)
enableRevAlerts      = input.bool(true,  "Reversal Exit Alerts",             group=grpRev)
showRevPoints        = input.bool(true,  "Show Reversal Points After Entry", group=grpRev)
revPointStyle        = input.string("Dot","Reversal Point Style", options=["Dot","Arrow"], group=grpRev)
revExitAfterTarget   = input.string("TP2","Allow Reversal Exit After", options=["TP2","TP3"], group=grpRev)
revStrongAtrMult     = input.float(0.50, "Strong Candle Body ATR Mult",      group=grpRev, step=0.05)
revStrongBodyPct     = input.float(0.60, "Strong Candle Body % Of Range",    group=grpRev, step=0.05)
revNeedCloseExtreme  = input.bool(true,  "Need Close Near Candle Extreme",   group=grpRev)
enableRevBeforeSL    = input.bool(true,  "Reversal Exit Before SL",          group=grpRev)
revNearSLAtrMult     = input.float(1.00, "Near SL ATR Distance",             group=grpRev, step=0.05)
showOnlyConfRev      = input.bool(false, "Show Only Confirmed Reversal",     group=grpRev)
flipOnRevExit        = input.bool(true,  "Flip Entry On Reversal Exit",      group=grpRev)
flipMinScore         = input.int(6,      "Flip Entry Min Score",             group=grpRev, minval=1, maxval=15)

// ═══════════════════════════════════════════════════════════
// INPUTS — SAFE EXIT
// ═══════════════════════════════════════════════════════════
grpSafe = "Safe Exit Mode"
enableSafeExit       = input.bool(true, "Enable Safe Exit Mode",            group=grpSafe)
safeExitAfterTP      = input.string("TP1","Allow Safe Exit After", options=["TP1","TP2","TP3"], group=grpSafe)
safeExitOnOppSignal  = input.bool(true, "Safe Exit On Opposite Signal",     group=grpSafe)
safeExitOnWeakFlow   = input.bool(true, "Safe Exit On Weak Order Flow",     group=grpSafe)
safeExitOnMacro      = input.bool(true, "Safe Exit On Macro Event Window",  group=grpSafe)
showSafeArea         = input.bool(true, "Show Safe Exit Area",              group=grpSafe)
safeExitBoxBars      = input.int(6,     "Safe Exit Area Width",             group=grpSafe)
enableSafeAlerts     = input.bool(true, "Safe Exit Alerts",                 group=grpSafe)
preferSafeOverRev    = input.bool(true, "Prefer Safe Exit Over Reversal",   group=grpSafe)

// ═══════════════════════════════════════════════════════════
// INPUTS — PROTECTION PAD
// ═══════════════════════════════════════════════════════════
grpPad = "Protection Pad"
enablePad     = input.bool(true,   "Enable Protection Pad",      group=grpPad)
padMode       = input.string("ATR","Pad Mode", options=["ATR","Points","Percent"], group=grpPad)
padAtrMult    = input.float(1.00,  "Pad ATR Mult",               group=grpPad, step=0.05)
padPoints     = input.float(100.0, "Pad Points",                 group=grpPad, step=0.1)
padPercent    = input.float(0.20,  "Pad Percent",                group=grpPad, step=0.01)
showPadLines  = input.bool(true,   "Show Protection Pad Lines",  group=grpPad)
usePadSafe    = input.bool(true,   "Use Pad In Safe Exit",       group=grpPad)
usePadRev     = input.bool(true,   "Use Pad In Reversal Exit",   group=grpPad)
enablePadAlerts = input.bool(true, "Protection Pad Alerts",      group=grpPad)

// ═══════════════════════════════════════════════════════════
// INPUTS — CTR CONFIRMATION
// ═══════════════════════════════════════════════════════════
grpCTR = "CTR Confirmation"
enableCTR       = input.bool(true,  "Enable CTR Confirmation",       group=grpCTR)
ctrLookback     = input.int(6,      "CTR Impulse Lookback",          group=grpCTR, minval=2, maxval=20)
ctrBodyAtrMult  = input.float(0.60, "Impulse Body ATR Mult",         group=grpCTR, step=0.05)
ctrNeedRetest   = input.bool(true,  "Need Mid-Range Retest",         group=grpCTR)
ctrNeedClose    = input.bool(true,  "Need Close In Direction",       group=grpCTR)
showCTRLevels   = input.bool(true,  "Show CTR Levels",               group=grpCTR)

// ═══════════════════════════════════════════════════════════
// INPUTS — ACCU-LOCK
// ═══════════════════════════════════════════════════════════
grpAL = "ACCU-LOCK Mode"
enableAccuLock   = input.bool(true, "Enable ACCU-LOCK Mode",           group=grpAL)
accuLockBars     = input.int(10,    "Lock Bars",                       group=grpAL, minval=3, maxval=300)
accuUnlockOnSL   = input.bool(true, "Unlock on StopLoss",              group=grpAL)
accuUnlockOnT5   = input.bool(true, "Unlock on Target5",               group=grpAL)
accuLockMinScore = input.int(7,     "Min Score to LOCK",               group=grpAL, minval=1, maxval=15)

// ═══════════════════════════════════════════════════════════
// INPUTS — SCALPING CORE
// ═══════════════════════════════════════════════════════════
grpCore = "Scalping Core"
htfFrame       = input.timeframe("60",  "HTF Trend TF",                    group=grpCore)
emaFastLen     = input.int(5,           "EMA Fast",                        group=grpCore)
emaSlowLen     = input.int(13,          "EMA Slow",                        group=grpCore)
ema200Len      = input.int(200,         "EMA 200",                         group=grpCore)
rsiLen         = input.int(7,           "RSI Length",                      group=grpCore)
atrLen         = input.int(14,          "ATR Length",                      group=grpCore)
minScore       = input.int(6,           "Min Score (1-15)",                group=grpCore, minval=1, maxval=15)
minBarsGap     = input.int(2,           "Min Bars Between Entries",        group=grpCore, minval=1, maxval=100)
entryOnClose   = input.bool(true,       "Entry Only On Close (No-Repaint)",group=grpCore)
entryBufATR    = input.float(0.10,      "Entry Flex Buffer ATR",           group=grpCore, step=0.05)
allowCross     = input.bool(true,       "Allow EMA Cross Entries",         group=grpCore)
allowSweep     = input.bool(true,       "Allow Sweep Reclaim Entries",     group=grpCore)
allowMSS       = input.bool(true,       "Allow MSS/BOS Entries",           group=grpCore)

// ═══════════════════════════════════════════════════════════
// INPUTS — ENTRY TYPE FILTERS
// ═══════════════════════════════════════════════════════════
grpET = "Entry Type Filters"
allowLQEntry   = input.bool(true,  "Allow LQ (Liquidity Sweep) Entries",  group=grpET)
allowREVEntry  = input.bool(true,  "Allow REV (Reversal CHoCH) Entries",  group=grpET)
allowMSNREntry = input.bool(true,  "Allow MSNR Entries",                  group=grpET)
allowCTREntry  = input.bool(true,  "Allow CTR (Impulse) Entries",         group=grpET)
allowPBEntry   = input.bool(true,  "Allow PB (EMA Pullback) Entries",     group=grpET)
allowBDEntry   = input.bool(true,  "Allow BD (BOS Breakout) Entries",     group=grpET)
allowBaseEntry = input.bool(true,  "Allow Base BUY/SELL Entries",         group=grpET)
blockSideways  = input.bool(false, "Block Entries In Sideways Market",    group=grpET)

// ═══════════════════════════════════════════════════════════
// INPUTS — TARGETS & RISK
// ═══════════════════════════════════════════════════════════
grpRisk = "Targets & Risk"
atrSLmult = input.float(2.5, "StopLoss ATR Mult", step=0.1, group=grpRisk)
t1mult    = input.float(1.0, "TP1 ATR Mult",      step=0.1, group=grpRisk)
t2mult    = input.float(2.0, "TP2 ATR Mult",      step=0.1, group=grpRisk)
t3mult    = input.float(3.0, "TP3 ATR Mult",      step=0.1, group=grpRisk)
t4mult    = input.float(5.0, "TP4 ATR Mult",      step=0.1, group=grpRisk)
t5mult    = input.float(8.0, "TP5 ATR Mult",      step=0.1, group=grpRisk)

// ═══════════════════════════════════════════════════════════
// INPUTS — SESSION FILTER
// ═══════════════════════════════════════════════════════════
grpSess = "Session Filter"
useSessionFilter = input.bool(true,   "Use Session Filter",  group=grpSess)
marketType       = input.string("AUTO","Market Type", options=["AUTO","NSE","CRYPTO","FOREX","GOLD"], group=grpSess)
sessionNSE       = input.session("0915-1515:1234567", "NSE Session",   group=grpSess)
sessionFX        = input.session("1300-2200:1234567", "Forex Session", group=grpSess)
sessionGOLD      = input.session("1430-2330:1234567", "Gold Session",  group=grpSess)

// ═══════════════════════════════════════════════════════════
// INPUTS — MARKET INTERNALS
// ═══════════════════════════════════════════════════════════
grpInt = "Core: Market Internals"
useMarketInternals   = input.bool(true,  "Use Market Internals",          group=grpInt)
strictProxySync      = input.bool(false, "Strict Sync (All must agree)",  group=grpInt)
hardBlockByInternals = input.bool(false, "Hard Block Entries",            group=grpInt)

// ═══════════════════════════════════════════════════════════
// INPUTS — VOLUME PRESSURE
// ═══════════════════════════════════════════════════════════
grpVol = "Core: Volume Pressure"
useVolPressure = input.bool(true, "Use Advanced Volume Pressure",    group=grpVol)
volLen         = input.int(20,    "Lookback",       minval=5,        group=grpVol)
volSmooth      = input.int(3,     "Smoothing",      minval=1,        group=grpVol)
pressureMode   = input.string("Automatic","Pressure Mode", options=["Manual","Automatic"], group=grpVol)
volumeMethod   = input.string("Close vs Typical","Manual Method", options=["Close vs Typical","Close vs Open","Volume * Price Change","OBV Method"], group=grpVol)

// ═══════════════════════════════════════════════════════════
// INPUTS — MARKET STRUCTURE THRESHOLDS
// ═══════════════════════════════════════════════════════════
grpMS2 = "Market Structure"
msSideThresh  = input.float(0.0018, "Sideways Threshold EMA Spread %",  step=0.0001, group=grpMS2)
msSlopeThresh = input.float(0.0006, "Sideways Threshold HTF Slope %",   step=0.0001, group=grpMS2)

// ═══════════════════════════════════════════════════════════
// INPUTS — MSNR
// ═══════════════════════════════════════════════════════════
grpMSNR = "MSNR Entry Concept"
useMSNR        = input.bool(true,  "Use MSNR Entry Filter",          group=grpMSNR)
msnrPivLen     = input.int(6,      "MSNR Pivot Length",              group=grpMSNR, minval=2, maxval=20)
msnrAtrBuf     = input.float(0.25, "MSNR Zone Buffer ATR",           group=grpMSNR, step=0.05)
msnrFreshBars  = input.int(80,     "MSNR Zone Freshness Bars",       group=grpMSNR, minval=10, maxval=500)
msnrNeedRej    = input.bool(true,  "Need Rejection Candle",          group=grpMSNR)
msnrNeedTrend  = input.bool(true,  "Need Trend Alignment",           group=grpMSNR)
showMSNR       = input.bool(true,  "Show MSNR Levels",               group=grpMSNR)

// ═══════════════════════════════════════════════════════════
// INPUTS — MACRO EVENTS
// ═══════════════════════════════════════════════════════════
grpMacro = "Macro Events"
useMacroEvents   = input.bool(true,  "Use Macro Event Filter",        group=grpMacro)
blockDuringMacro = input.bool(true,  "Block Entries During Window",   group=grpMacro)
boostScoreMacro  = input.bool(true,  "Increase Score In Window",      group=grpMacro)
macroScoreBoost  = input.int(3,      "Extra Score In Window",         group=grpMacro, minval=1, maxval=10)
showMacroDash    = input.bool(true,  "Show Macro On Dashboard",       group=grpMacro)

preFomcMin  = input.int(60, "FOMC: Mins Before", group=grpMacro)
postFomcMin = input.int(60, "FOMC: Mins After",  group=grpMacro)
preNfpMin   = input.int(30, "NFP: Mins Before",  group=grpMacro)
postNfpMin  = input.int(30, "NFP: Mins After",   group=grpMacro)
preCpiMin   = input.int(30, "CPI: Mins Before",  group=grpMacro)
postCpiMin  = input.int(30, "CPI: Mins After",   group=grpMacro)
prePpiMin   = input.int(20, "PPI: Mins Before",  group=grpMacro)
postPpiMin  = input.int(20, "PPI: Mins After",   group=grpMacro)

useFOMC = input.bool(true, "Use FOMC", group=grpMacro)
useNFP  = input.bool(true, "Use NFP",  group=grpMacro)
useCPI  = input.bool(true, "Use CPI",  group=grpMacro)
usePPI  = input.bool(true, "Use PPI",  group=grpMacro)

fomcTimeInp = input.time(1767225600000, "FOMC Event Time (UTC)", group=grpMacro)
nfpTimeInp  = input.time(1767225600000, "NFP Event Time (UTC)",  group=grpMacro)
cpiTimeInp  = input.time(1767225600000, "CPI Event Time (UTC)",  group=grpMacro)
ppiTimeInp  = input.time(1767225600000, "PPI Event Time (UTC)",  group=grpMacro)

useManualMacroBias = input.bool(false,    "Use Manual Macro Bias",  group=grpMacro)
macroBiasInput     = input.string("NEUTRAL","Manual Macro Bias", options=["BULLISH","BEARISH","NEUTRAL"], group=grpMacro)

// ═══════════════════════════════════════════════════════════
// INPUTS — ALERTS
// ═══════════════════════════════════════════════════════════
grpAlerts = "Alerts"
enableEntryAlerts  = input.bool(true, "Entry Alerts",   group=grpAlerts)
enableSLAlerts     = input.bool(true, "Stop Loss Alerts", group=grpAlerts)
enableTPAlerts     = input.bool(true, "Target Alerts",  group=grpAlerts)

// ═══════════════════════════════════════════════════════════
// INPUTS — NO-CHASE / LATE ENTRY FILTER
// ═══════════════════════════════════════════════════════════
grpChase = "No-Chase Filter"
enableChaseFilter   = input.bool(true,  "Enable No-Chase Filter",            group=grpChase)
chaseEmaDistMult    = input.float(1.5,  "Max Distance from EMA Fast (ATR)",  group=grpChase, step=0.1, minval=0.3)
chaseVwapDistMult   = input.float(2.0,  "Max Distance from VWAP (ATR)",      group=grpChase, step=0.1, minval=0.3)
chaseMsnrDistMult   = input.float(2.5,  "Max Distance from MSNR Zone (ATR)", group=grpChase, step=0.1, minval=0.3)
chaseDispMult       = input.float(1.8,  "Displacement Candle ATR Mult",      group=grpChase, step=0.1, minval=0.5)
chaseBlockLate      = input.bool(false, "Hard Block on LATE (vs penalise)",   group=grpChase)

// ═══════════════════════════════════════════════════════════
// INPUTS — OB PROXIMITY FILTER
// ═══════════════════════════════════════════════════════════
grpOBProx = "OB Proximity Filter"
enableOBProxFilter  = input.bool(true,  "Enable OB Proximity Filter",        group=grpOBProx)
obProxAtrMult       = input.float(0.8,  "Too-Close ATR Threshold",           group=grpOBProx, step=0.1, minval=0.2)
obProxPenalise      = input.bool(true,  "Penalise Score When OB Too Close",  group=grpOBProx)
obProxHardBlock     = input.bool(false, "Hard Block When OB Too Close",      group=grpOBProx)

// ═══════════════════════════════════════════════════════════
// INPUTS — CANDLE BODY STRENGTH FILTER
// ═══════════════════════════════════════════════════════════
grpCandleBody = "Candle Body Strength Filter"
enableCandleBodyFilter = input.bool(true,  "Enable Candle Body Filter",             group=grpCandleBody)
candleBodyAvgLen       = input.int(5,      "Avg Body Lookback (bars)",              group=grpCandleBody, minval=2, maxval=20)
candleBodyAvgMult      = input.float(1.2,  "Min Body vs Avg Body Multiplier",      group=grpCandleBody, step=0.1, minval=0.5)
candleBodyMinAtrPct    = input.float(0.20, "Min Body as % of ATR (0.20 = 20%)",   group=grpCandleBody, step=0.05, minval=0.05, maxval=1.0)
candleBodyHardBlock    = input.bool(true,  "Hard Block Weak Candle (vs penalise)", group=grpCandleBody)

// ═══════════════════════════════════════════════════════════
// INPUTS — ADX TREND STRENGTH FILTER
// ═══════════════════════════════════════════════════════════
grpADX          = "ADX Trend Strength Filter"
enableADXFilter = input.bool(true,  "Enable ADX Filter",                                     group=grpADX)
adxLen          = input.int(14,    "ADX Length",                    minval=2, maxval=50,      group=grpADX)
adxThresh       = input.int(20,    "ADX Minimum Threshold",         minval=10, maxval=50,     group=grpADX)
adxAllowRising  = input.bool(true, "Also Allow if ADX Rising",                               group=grpADX)
adxRisingBars   = input.int(2,     "Rising: ADX up for N bars",     minval=1, maxval=5,       group=grpADX)
adxHardBlock    = input.bool(true, "Hard Block Entry on Weak ADX",                           group=grpADX)

// ═══════════════════════════════════════════════════════════
// INPUTS — SCORING ENGINE (REAL RAW SCORE)
// ═══════════════════════════════════════════════════════════
grpRealScore = "Real Score Engine"
scoreMaxRaw  = input.int(28, "Raw Score Max (for normalisation)", group=grpRealScore, minval=15, maxval=50)

// ═══════════════════════════════════════════════════════════
// CORE INDICATORS
// ═══════════════════════════════════════════════════════════
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
ema200   = ta.ema(close, ema200Len)
rsi      = ta.rsi(close, rsiLen)
atr      = ta.atr(atrLen)
vwapVal  = ta.vwap(hlc3)

htfEma200 = request.security(syminfo.tickerid, htfFrame, ta.ema(close, ema200Len), lookahead=barmerge.lookahead_off)
htfBull   = close > htfEma200
htfBear   = close < htfEma200
htfSlope  = htfEma200 - nz(htfEma200[1])

emaSpreadPct = math.abs(emaFast - emaSlow) / close
slopePct     = math.abs(htfSlope) / close

// ═══════════════════════════════════════════════════════════
// ADX TREND STRENGTH
// ═══════════════════════════════════════════════════════════
[adxDiPlus, adxDiMinus, adxVal] = ta.dmi(adxLen, adxLen)
// ADX rising: must be higher than N bars ago
adxIsRising = adxVal > adxVal[adxRisingBars]
// PASS if: above threshold OR (allow-rising AND actually rising)
adxOk     = not enableADXFilter or (adxVal >= adxThresh) or (adxAllowRising and adxIsRising)
adxTxt    = not enableADXFilter ? "ADX OFF" : adxVal >= adxThresh ? "ADX STRONG ✅ (" + str.tostring(math.round(adxVal, 1)) + ")" : adxIsRising ? "ADX RISING ⚠️ (" + str.tostring(math.round(adxVal, 1)) + ")" : "ADX WEAK 🚫 (" + str.tostring(math.round(adxVal, 1)) + ")"
adxCol    = not enableADXFilter ? c_text_m : adxVal >= adxThresh ? c_green : adxIsRising ? c_orange : c_red

isSideways    = emaSpreadPct < msSideThresh and slopePct < msSlopeThresh and rsi > 42 and rsi < 58
emaCrossOver  = ta.crossover(emaFast,  emaSlow)
emaCrossUnder = ta.crossunder(emaFast, emaSlow)
isBullMS   = not isSideways and close > ema200 and (emaFast >= emaSlow or emaCrossOver)  and htfSlope >= 0
isBearMS   = not isSideways and close < ema200 and (emaFast <= emaSlow or emaCrossUnder) and htfSlope <= 0

msText = isBullMS ? "BULLISH ✅" : isBearMS ? "BEARISH ✅" : "SIDEWAYS ⚠️"
msCol  = isBullMS ? c_green : isBearMS ? c_red : c_orange

// CPR (Daily)
dh_d = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
dl_d = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
dc_d = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
cpr_pivot = (dh_d + dl_d + dc_d) / 3
cpr_bc    = (dh_d + dl_d) / 2
cpr_tc    = (cpr_pivot - cpr_bc) + cpr_pivot
above_cpr = close > cpr_tc
below_cpr = close < cpr_bc

// ═══════════════════════════════════════════════════════════
// CANDLE ANATOMY
// ═══════════════════════════════════════════════════════════
candleRange  = high - low
candleBody   = math.abs(close - open)
bodyPct      = candleRange > 0 ? candleBody / candleRange : 0.0
closeNearLow  = candleRange > 0 and close <= low  + candleRange * 0.25
closeNearHigh = candleRange > 0 and close >= high - candleRange * 0.25

bullReject     = close > open and (math.min(close,open) - low)  > candleBody * 1.5 and close > (high+low)/2
bearReject     = close < open and (high - math.max(close,open)) > candleBody * 1.5 and close < (high+low)/2
micro_doji     = bodyPct < 0.20 and candleRange > 0
strongBearCdl  = close < open and candleBody >= atr * revStrongAtrMult and bodyPct >= revStrongBodyPct and (not revNeedCloseExtreme or closeNearLow)
strongBullCdl  = close > open and candleBody >= atr * revStrongAtrMult and bodyPct >= revStrongBodyPct and (not revNeedCloseExtreme or closeNearHigh)

fastBearPress = close < open and close < emaFast and close <= low + candleRange * 0.45 and close < close[1] and bodyPct >= 0.30
fastBullPress = close > open and close > emaFast and close >= high - candleRange * 0.45 and close > close[1] and bodyPct >= 0.30

// ═══════════════════════════════════════════════════════════
// CANDLE BODY STRENGTH FILTER
// ═══════════════════════════════════════════════════════════
// Average body size of recent N candles (excluding current)
avgBody5 = (math.abs(close[1]-open[1]) + math.abs(close[2]-open[2]) + math.abs(close[3]-open[3]) + math.abs(close[4]-open[4]) + math.abs(close[5]-open[5])) / math.max(candleBodyAvgLen, 1)
// Body is strong if it exceeds avgBody × multiplier OR exceeds the ATR minimum %
bodyStrongVsAvg = candleBody >= avgBody5 * candleBodyAvgMult
bodyStrongVsATR = candleBody >= atr * candleBodyMinAtrPct
// Pass if either condition met (OR logic — not both required)
bodySufficient  = not enableCandleBodyFilter or bodyStrongVsAvg or bodyStrongVsATR
bodyFilterTxt   = not enableCandleBodyFilter ? "FILTER OFF" : bodySufficient ? "BODY OK ✅" : "WEAK BODY 🚫"
bodyFilterCol   = not enableCandleBodyFilter ? c_text_m : bodySufficient ? c_green : c_red

// ═══════════════════════════════════════════════════════════
// SESSION LOGIC
// ═══════════════════════════════════════════════════════════
isCrypto = marketType == "CRYPTO"
isForex  = marketType == "FOREX"
isNSE    = marketType == "NSE"
isGold   = marketType == "GOLD"

inSession = not useSessionFilter or (
     isCrypto or (marketType == "AUTO" and isAutoCrypto) ? true :
     isNSE    or (marketType == "AUTO" and isAutoNSE)    ? not na(time(timeframe.period, sessionNSE)) :
     isForex  or (marketType == "AUTO" and isAutoForex)  ? not na(time(timeframe.period, sessionFX)) :
     isGold ? not na(time(timeframe.period, sessionGOLD)) :
     true)

// ═══════════════════════════════════════════════════════════
// ICT KILLZONES (IST)
// ═══════════════════════════════════════════════════════════
currHour     = hour(time,   "GMT+5:30")
currMin      = minute(time, "GMT+5:30")
currFlat     = currHour * 100 + currMin
isLondonKZ   = currFlat >= 1330 and currFlat <= 1630
isNYKZ       = currFlat >= 1830 and currFlat <= 2130
isKillzone   = isLondonKZ or isNYKZ

// ═══════════════════════════════════════════════════════════
// NSE TRADING WINDOW — IST
// No entries before 9:15 AM or at/after 3:00 PM
// isNSECloseBar fires on the first bar that reaches 15:00
// ═══════════════════════════════════════════════════════════
inNSEWindow   = currFlat >= 915 and currFlat < 1500
isNSECloseBar = currFlat >= 1500 and currFlat < 1505


// ═══════════════════════════════════════════════════════════
// SMC MARKET STRUCTURE — pivot-based BOS/CHoCH
// ═══════════════════════════════════════════════════════════
smc_ph = ta.pivothigh(high, ms_len, ms_len)
smc_pl = ta.pivotlow(low,   ms_len, ms_len)

var float smc_last_ph = na
var float smc_last_pl = na
if not na(smc_ph)
    smc_last_ph := smc_ph
if not na(smc_pl)
    smc_last_pl := smc_pl

var string smc_dir    = "sideways"
var bool   smc_bos_bull   = false
var bool   smc_bos_bear   = false
var bool   smc_choch_bull = false
var bool   smc_choch_bear = false

smc_bos_bull   := false
smc_bos_bear   := false
smc_choch_bull := false
smc_choch_bear := false

if not na(smc_last_ph) and not na(smc_last_pl)
    if close[1] > smc_last_ph and smc_dir != "bullish"
        smc_choch_bull := smc_dir == "bearish"
        smc_bos_bull   := smc_dir != "bearish"
        smc_dir        := "bullish"
    if close[1] < smc_last_pl and smc_dir != "bearish"
        smc_choch_bear := smc_dir == "bullish"
        smc_bos_bear   := smc_dir != "bullish"
        smc_dir        := "bearish"

smc_ms_bull = smc_dir == "bullish"
smc_ms_bear = smc_dir == "bearish"
smc_ms_bull_conf = smc_ms_bull and smc_ms_bull[1]
smc_ms_bear_conf = smc_ms_bear and smc_ms_bear[1]

if showBOSLabels
    if smc_bos_bull[1]
        label.new(bar_index-1, low[1]  - atr*0.5, "BOS ▲",   color=color.new(color.teal,0),   textcolor=color.white, style=label.style_label_up,   size=size.tiny)
    if smc_bos_bear[1]
        label.new(bar_index-1, high[1] + atr*0.5, "BOS ▼",   color=color.new(color.red,0),    textcolor=color.white, style=label.style_label_down, size=size.tiny)
    if smc_choch_bull[1]
        label.new(bar_index-1, low[1]  - atr*0.8, "CHoCH ▲", color=color.new(color.lime,0),   textcolor=color.black, style=label.style_label_up,   size=size.tiny)
    if smc_choch_bear[1]
        label.new(bar_index-1, high[1] + atr*0.8, "CHoCH ▼", color=color.new(color.orange,0), textcolor=color.white, style=label.style_label_down, size=size.tiny)

// ═══════════════════════════════════════════════════════════
// ORDER BLOCKS
// ═══════════════════════════════════════════════════════════
ob_bull_piv = ta.pivotlow(low,   ob_len, ob_len)
ob_bear_piv = ta.pivothigh(high, ob_len, ob_len)

var float ob_bull_top = na
var float ob_bull_bot = na
var float ob_bear_top = na
var float ob_bear_bot = na

canDrawRecent = bar_index > last_bar_index - recentOnlyBars

if not na(ob_bull_piv)
    ob_bull_top := open[ob_len]
    ob_bull_bot := low[ob_len]
    if showOB and canDrawRecent
        box.new(bar_index - ob_len, ob_bull_top, bar_index + 20, ob_bull_bot,
             border_color=color.new(color.teal,20), bgcolor=color.new(color.teal,85), border_width=1)

if not na(ob_bear_piv)
    ob_bear_top := high[ob_len]
    ob_bear_bot := open[ob_len]
    if showOB and canDrawRecent
        box.new(bar_index - ob_len, ob_bear_top, bar_index + 20, ob_bear_bot,
             border_color=color.new(color.red,20), bgcolor=color.new(color.red,85), border_width=1)

in_bull_ob = not na(ob_bull_top) and close >= ob_bull_bot and close <= ob_bull_top
in_bear_ob = not na(ob_bear_top) and close >= ob_bear_bot and close <= ob_bear_top

// ═══════════════════════════════════════════════════════════
// FVG
// ═══════════════════════════════════════════════════════════
bullFVG = low > high[2] and close[1] > open[1]
bearFVG = high < low[2] and close[1] < open[1]

if showFVG and canDrawRecent
    if bullFVG
        box.new(bar_index-2, high[2], bar_index+12, low, border_color=color.new(color.aqua,40),   bgcolor=color.new(color.aqua,90),   border_width=1, text="FVG", text_color=color.new(color.white,30), text_size=size.tiny)
    if bearFVG
        box.new(bar_index-2, high,    bar_index+12, low[2], border_color=color.new(color.orange,40), bgcolor=color.new(color.orange,90), border_width=1, text="FVG", text_color=color.new(color.white,30), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════
// EQH / EQL LIQUIDITY
// ═══════════════════════════════════════════════════════════
liq_tol = atr * liq_tol_mult
eq_high = math.abs(high - high[1]) < liq_tol and math.abs(high - high[2]) < liq_tol
eq_low  = math.abs(low  - low[1])  < liq_tol and math.abs(low  - low[2])  < liq_tol

if showLiq and canDrawRecent
    if eq_high[1]
        line.new(bar_index-3, high[1], bar_index+20, high[1], color=color.new(color.yellow,20), style=line.style_dashed, width=1)
        label.new(bar_index-1, high[1] + atr*0.3, "EQH 💧", color=color.new(color.yellow,70), textcolor=color.white, style=label.style_none, size=size.tiny)
    if eq_low[1]
        line.new(bar_index-3, low[1], bar_index+20, low[1], color=color.new(color.yellow,20), style=line.style_dashed, width=1)
        label.new(bar_index-1, low[1] - atr*0.3, "EQL 💧", color=color.new(color.yellow,70), textcolor=color.white, style=label.style_none, size=size.tiny)

// ═══════════════════════════════════════════════════════════
// LIQUIDITY SWEEPS / MSS / BOS (20-bar fast version)
// ═══════════════════════════════════════════════════════════
lowest20_1  = ta.lowest(low,   20)[1]
highest20_1 = ta.highest(high, 20)[1]
sweepLow  = low  < lowest20_1  and close > lowest20_1
sweepHigh = high > highest20_1 and close < highest20_1

smc_ph5 = ta.pivothigh(high, 5, 5)
smc_pl5 = ta.pivotlow(low,   5, 5)

var float lastPH5 = na
var float lastPL5 = na
if not na(smc_ph5)
    lastPH5 := smc_ph5
if not na(smc_pl5)
    lastPL5 := smc_pl5

mssBuy  = not na(lastPH5) and close > lastPH5 and close[1] <= lastPH5
mssSell = not na(lastPL5) and close < lastPL5 and close[1] >= lastPL5
bosBuy  = close > highest20_1
bosSell = close < lowest20_1

// SOS / MSS (SMC volume-confirmed)
vol_ma_20  = ta.sma(volume, 20)
vol_high   = volume > vol_ma_20 * 1.5
sos_bull   = smc_bos_bull and vol_high and close > emaSlow
sos_bear   = smc_bos_bear and vol_high and close < emaSlow
mss_bull_s = smc_choch_bull and rsi > 50
mss_bear_s = smc_choch_bear and rsi < 50

// ═══════════════════════════════════════════════════════════
// MSNR LEVELS
// ═══════════════════════════════════════════════════════════
msnrPH = ta.pivothigh(high, msnrPivLen, msnrPivLen)
msnrPL = ta.pivotlow(low,   msnrPivLen, msnrPivLen)

var float msnrRes    = na
var float msnrSup    = na
var int   msnrResBar = na
var int   msnrSupBar = na

if not na(msnrPH)
    msnrRes    := msnrPH
    msnrResBar := bar_index - msnrPivLen
if not na(msnrPL)
    msnrSup    := msnrPL
    msnrSupBar := bar_index - msnrPivLen

msnrBuf      = atr * msnrAtrBuf
msnrSupFresh = not na(msnrSupBar) and (bar_index - msnrSupBar <= msnrFreshBars)
msnrResFresh = not na(msnrResBar) and (bar_index - msnrResBar <= msnrFreshBars)

nearMSNRSup = not na(msnrSup) and low  <= msnrSup + msnrBuf and close >= msnrSup - msnrBuf
nearMSNRRes = not na(msnrRes) and high >= msnrRes - msnrBuf and close <= msnrRes + msnrBuf

msnrBuyConfirm  = sweepLow  or mssBuy  or bosBuy  or emaCrossOver
msnrSellConfirm = sweepHigh or mssSell or bosSell or emaCrossUnder

msnrTrendBuyOk  = not msnrNeedTrend or isBullMS or htfBull
msnrTrendSellOk = not msnrNeedTrend or isBearMS or htfBear

bool msnrBuyOk  = msnrSupFresh and nearMSNRSup and msnrBuyConfirm  and msnrTrendBuyOk
bool msnrSellOk = msnrResFresh and nearMSNRRes and msnrSellConfirm and msnrTrendSellOk

if msnrNeedRej
    msnrBuyOk  := msnrBuyOk  and bullReject
    msnrSellOk := msnrSellOk and bearReject

// ═══════════════════════════════════════════════════════════
// FIB OTE
// ═══════════════════════════════════════════════════════════
fibHigh   = ta.highest(high, 50)
fibLow    = ta.lowest(low,   50)
fibR      = fibHigh - fibLow
fib382    = fibLow + fibR * 0.382
fib500    = fibLow + fibR * 0.500
fib618    = fibLow + fibR * 0.618
isNearFib = math.abs(close - fib382)/close < 0.01 or math.abs(close - fib500)/close < 0.01 or math.abs(close - fib618)/close < 0.01

// ═══════════════════════════════════════════════════════════
// MANUAL OBV
// ═══════════════════════════════════════════════════════════
var float obvSeries = 0.0
obvSeries := nz(obvSeries[1]) + (close > close[1] ? volume : close < close[1] ? -volume : 0.0)

// ═══════════════════════════════════════════════════════════
// ADVANCED VOLUME PRESSURE
// ═══════════════════════════════════════════════════════════
typical_price    = (high + low + close) / 3.0
// ta.change must be called every bar at global scope before any conditional
price_change_g   = ta.change(close)
obv_change_g     = ta.change(obvSeries)
priceReturns     = price_change_g / close[1] * 100
rollingVol       = ta.stdev(priceReturns, 20)
bool noVol       = na(volume) or volume == 0
volProxy         = noVol ? (high - low) : volume

var string activeVolMethod = "Close vs Typical"
if pressureMode == "Automatic"
    tfMin    = timeframe.in_seconds() / 60.0
    isMicro  = tfMin <= 5
    isShort  = tfMin > 5  and tfMin <= 30
    isMedium = tfMin > 30 and tfMin <= 240
    if isMicro
        activeVolMethod := rollingVol > 2.0 ? "Volume * Price Change" : rollingVol < 0.3 ? "OBV Method" : "Close vs Open"
    else if isShort
        activeVolMethod := rollingVol > 1.5 ? "Volume * Price Change" : rollingVol < 0.4 ? "OBV Method" : "Close vs Open"
    else if isMedium
        activeVolMethod := rollingVol > 1.2 ? "Volume * Price Change" : rollingVol < 0.5 ? "OBV Method" : "Close vs Typical"
    else
        activeVolMethod := rollingVol > 1.0 ? "Close vs Typical" : "OBV Method"
else
    activeVolMethod := volumeMethod

float buy_press  = 0.0
float sell_press = 0.0

if activeVolMethod == "Close vs Typical"
    buy_press  := close > typical_price ? volProxy * (close - typical_price) / typical_price : 0
    sell_press := close < typical_price ? volProxy * (typical_price - close) / typical_price : 0
else if activeVolMethod == "Close vs Open"
    buy_press  := close > open ? volProxy * (close - open) / open : 0
    sell_press := close < open ? volProxy * (open - close) / open : 0
else if activeVolMethod == "Volume * Price Change"
    buy_press  := price_change_g > 0 ? volProxy * price_change_g / close[1] : 0
    sell_press := price_change_g < 0 ? volProxy * math.abs(price_change_g) / close[1] : 0
else
    buy_press  := obv_change_g > 0 ? math.abs(obv_change_g) : 0
    sell_press := obv_change_g < 0 ? math.abs(obv_change_g) : 0

var float[] buy_hist  = array.new_float()
var float[] sell_hist = array.new_float()
array.push(buy_hist,  buy_press)
array.push(sell_hist, sell_press)
if array.size(buy_hist) > volLen * 2
    array.shift(buy_hist)
    array.shift(sell_hist)

min_b = array.min(buy_hist)
max_b = array.max(buy_hist)
min_s = array.min(sell_hist)
max_s = array.max(sell_hist)

norm_b_raw = max_b > min_b ? (buy_press  - min_b) / (max_b - min_b) * 100 : 50
norm_s_raw = max_s > min_s ? (sell_press - min_s) / (max_s - min_s) * 100 : 50
norm_b = ta.ema(norm_b_raw, volSmooth)
norm_s = ta.ema(norm_s_raw, volSmooth)

net_pressure  = norm_b - norm_s
total_pressure = norm_b + norm_s
buy_ratio_adv  = total_pressure > 0 ? norm_b / total_pressure : 0.5

buy_vol_alert  = useVolPressure and net_pressure > -5  and buy_ratio_adv > 0.52
sell_vol_alert = useVolPressure and net_pressure < 5   and buy_ratio_adv < 0.48

// ═══════════════════════════════════════════════════════════
// MARKET INTERNALS
// ═══════════════════════════════════════════════════════════
sec_vix = request.security("CBOE:VIX",          "D", close, ignore_invalid_symbol=true)
sec_adv = request.security("NYSE:ADVN",          "D", close, ignore_invalid_symbol=true)
sec_dec = request.security("NYSE:DECN",          "D", close, ignore_invalid_symbol=true)
sec_spy = request.security("AMEX:SPY",           "D", close, ignore_invalid_symbol=true)
sec_tlt = request.security("NASDAQ:TLT",         "D", close, ignore_invalid_symbol=true)
sec_dxy = request.security("TVC:DXY",            "D", close, ignore_invalid_symbol=true)
sec_btc = request.security("BITSTAMP:BTCUSD",    "D", close, ignore_invalid_symbol=true)

ad_ratio       = not na(sec_adv) and not na(sec_dec) and (sec_adv+sec_dec)!=0 ? sec_adv/(sec_adv+sec_dec) : 0.5
risk_on_ratio  = not na(sec_spy) and not na(sec_tlt) and sec_tlt!=0 ? sec_spy/sec_tlt : 1.0
risk_trend     = risk_on_ratio > nz(risk_on_ratio[1])
vix_safe       = na(sec_vix) ? true : sec_vix < 22 or sec_vix < nz(sec_vix[1])
dxy_ok         = not na(sec_dxy) ? sec_dxy <= nz(sec_dxy[1]) : true
btc_bull       = not na(sec_btc) ? sec_btc >= nz(sec_btc[1]) : true

internalsOk    = not na(sec_spy) and not na(sec_tlt) and not na(sec_dxy)
useIntNow      = useMarketInternals and internalsOk

f_proxies(bool isLong) =>
    bool p = true
    if useIntNow
        if isLong
            c1 = vix_safe
            c2 = ad_ratio > 0.50
            c3 = risk_trend
            c4 = dxy_ok
            c5 = isAutoCrypto ? btc_bull : true
            p  := strictProxySync ? (c1 and c2 and c3 and c4 and c5) : ((c1?1:0)+(c2?1:0)+(c3?1:0)+(c4?1:0)+(c5?1:0)) >= 2
        else
            c1 = not vix_safe
            c2 = ad_ratio < 0.50
            c3 = not risk_trend
            c4 = not dxy_ok
            c5 = isAutoCrypto ? not btc_bull : true
            p  := strictProxySync ? (c1 and c2 and c3 and c4 and c5) : ((c1?1:0)+(c2?1:0)+(c3?1:0)+(c4?1:0)+(c5?1:0)) >= 2
    p

proxiesOkBuy  = f_proxies(true)
proxiesOkSell = f_proxies(false)

// ═══════════════════════════════════════════════════════════
// MACRO EVENT LOGIC
// ═══════════════════════════════════════════════════════════
f_inWin(int ts, int pre, int post) => ts > 1767225600000 and time >= ts - pre*60000 and time <= ts + post*60000
f_delta(int ts) => ts > time ? ts - time : na

isFomcWin = useMacroEvents and useFOMC and f_inWin(fomcTimeInp, preFomcMin, postFomcMin)
isNfpWin  = useMacroEvents and useNFP  and f_inWin(nfpTimeInp,  preNfpMin,  postNfpMin)
isCpiWin  = useMacroEvents and useCPI  and f_inWin(cpiTimeInp,  preCpiMin,  postCpiMin)
isPpiWin  = useMacroEvents and usePPI  and f_inWin(ppiTimeInp,  prePpiMin,  postPpiMin)

isMacroWin   = isFomcWin or isNfpWin or isCpiWin or isPpiWin
macroEvtName = isFomcWin ? "FOMC" : isNfpWin ? "NFP" : isCpiWin ? "CPI" : isPpiWin ? "PPI" : "NONE"

fd1 = useFOMC ? f_delta(fomcTimeInp) : na
fd2 = useNFP  ? f_delta(nfpTimeInp)  : na
fd3 = useCPI  ? f_delta(cpiTimeInp)  : na
fd4 = usePPI  ? f_delta(ppiTimeInp)  : na

float nextDelta = na
string nextMacroName = "NONE"
if not na(fd1)
    nextDelta := fd1
    nextMacroName := "FOMC"
if not na(fd2) and (na(nextDelta) or fd2 < nextDelta)
    nextDelta := fd2
    nextMacroName := "NFP"
if not na(fd3) and (na(nextDelta) or fd3 < nextDelta)
    nextDelta := fd3
    nextMacroName := "CPI"
if not na(fd4) and (na(nextDelta) or fd4 < nextDelta)
    nextDelta := fd4
    nextMacroName := "PPI"

nextMacroMins = na(nextDelta) ? na : int(math.round(nextDelta / 60000.0))
nextMacroTxt  = na(nextMacroMins) ? "NONE SET" : nextMacroName + " IN " + str.tostring(nextMacroMins) + "m"

macroBias = useManualMacroBias ? macroBiasInput : "NEUTRAL"
macroBull = macroBias == "BULLISH"
macroBear = macroBias == "BEARISH"

// ═══════════════════════════════════════════════════════════
// MAGNET ENGINE (AIA)
// ═══════════════════════════════════════════════════════════
isHighVol     = volume > ta.sma(volume,20) * 1.8 or noVol
disp_ratio    = math.abs(close - open) / (high - low + 1e-10)
isDisplaced   = disp_ratio > 0.65 and (high - low) > atr * 0.8

highest20_cur = ta.highest(high, 20)
lowest20_cur  = ta.lowest(low,  20)

liqTaken         = sweepLow or sweepHigh or bosBuy or bosSell
liq_mag_active   = liqTaken and (math.abs(close - highest20_cur) / (atr+1e-10) < 1.2 or math.abs(close - lowest20_cur) / (atr+1e-10) < 1.2)
vol_mag_active   = isHighVol and isDisplaced

aia_score = 0
aia_score += liq_mag_active       ? 25 : 0
aia_score += vol_mag_active       ? 25 : 0
aia_score += (mssBuy or mssSell)  ? 20 : 0
aia_score += isNearFib            ? 10 : 0
aia_score += isKillzone           ? 10 : 0
aia_score += (buy_vol_alert or sell_vol_alert) ? 10 : 0
aia_score += (msnrBuyOk or msnrSellOk)        ? 10 : 0
aia_score := math.min(100, aia_score)
aia_active = aia_score >= 70

// ═══════════════════════════════════════════════════════════
// IMPROVED LSDR ENGINE
// ═══════════════════════════════════════════════════════════
lsdrSwpBull = sweepLow  or nearMSNRSup
lsdrSwpBear = sweepHigh or nearMSNRRes
lsdrDispBull = isDisplaced and close > open
lsdrDispBear = isDisplaced and close < open
crossOverCloseEmaFast  = ta.crossover(close,  emaFast)
crossUnderCloseEmaFast = ta.crossunder(close, emaFast)
lsdrRclmBull = close > emaFast or crossOverCloseEmaFast
lsdrRclmBear = close < emaFast or crossUnderCloseEmaFast
lsdrCnfmBull = bullReject or mssBuy  or bosBuy  or lsdrRclmBull
lsdrCnfmBear = bearReject or mssSell or bosSell or lsdrRclmBear
lsdrBull     = lsdrSwpBull and (lsdrDispBull or lsdrCnfmBull)
lsdrBear     = lsdrSwpBear and (lsdrDispBear or lsdrCnfmBear)
lsdrTxt      = lsdrBull ? "BULL LSDR ✅" : lsdrBear ? "BEAR LSDR ✅" : (lsdrSwpBull ? "BULL BUILD" : lsdrSwpBear ? "BEAR BUILD" : "NO LSDR")
lsdrCol      = lsdrBull ? c_green : lsdrBear ? c_red : (lsdrSwpBull or lsdrSwpBear) ? c_orange : c_text_m

// ═══════════════════════════════════════════════════════════
// CTR / CRT CONFIRMATION
// ═══════════════════════════════════════════════════════════
var float ctrBullMid = na
var float ctrBearMid = na
var float ctrBullHi  = na
var float ctrBullLo  = na
var float ctrBearHi  = na
var float ctrBearLo  = na

ctrHighestClose = ta.highest(close, ctrLookback)
ctrLowestClose  = ta.lowest(close,  ctrLookback)
impulseBull = close > open and (close - open) >= atr * ctrBodyAtrMult and close >= ctrHighestClose
impulseBear = close < open and (open - close) >= atr * ctrBodyAtrMult and close <= ctrLowestClose

if impulseBull
    ctrBullHi  := high
    ctrBullLo  := low
    ctrBullMid := (high + low) / 2
if impulseBear
    ctrBearHi  := high
    ctrBearLo  := low
    ctrBearMid := (high + low) / 2

ctrBullRetest  = not na(ctrBullMid) and low  <= ctrBullMid and close >= ctrBullMid
ctrBearRetest  = not na(ctrBearMid) and high >= ctrBearMid and close <= ctrBearMid
ctrBullCloseOk = close > open and close >= nz(ctrBullMid, close)
ctrBearCloseOk = close < open and close <= nz(ctrBearMid, close)

ctrBuyOk  = not enableCTR ? true : not ctrNeedRetest ? ctrBullCloseOk : ctrBullRetest and (not ctrNeedClose or ctrBullCloseOk)
ctrSellOk = not enableCTR ? true : not ctrNeedRetest ? ctrBearCloseOk : ctrBearRetest and (not ctrNeedClose or ctrBearCloseOk)

// ═══════════════════════════════════════════════════════════
// SCORING ENGINE — RAW (UNBOUNDED) + NORMALISED + GRADE
// ═══════════════════════════════════════════════════════════
entryFlex = atr * entryBufATR

// ── Raw base scores (no cap — real unbounded total) ──────
scoreBuy  = 0
scoreSell = 0

// Trend alignment HTF + LTF (max 3)
scoreBuy  += (close >= ema200 - entryFlex and emaFast >= emaSlow and htfBull) ? 3 : 0
scoreSell += (close <= ema200 + entryFlex and emaFast <= emaSlow and htfBear) ? 3 : 0

// Momentum RSI (max 2) — non-overlapping zones to prevent both scoring in chop
scoreBuy  += (rsi > 55 and rsi < 80) ? 2 : 0
scoreSell += (rsi < 45 and rsi > 20) ? 2 : 0

// VWAP (max 2)
scoreBuy  += close >= vwapVal - entryFlex ? 2 : 0
scoreSell += close <= vwapVal + entryFlex ? 2 : 0

// Volume pressure (max 2)
scoreBuy  += buy_vol_alert  ? 2 : 0
scoreSell += sell_vol_alert ? 2 : 0

// Market structure (max 2)
scoreBuy  += isBullMS ? 2 : 0
scoreSell += isBearMS ? 2 : 0

// EMA cross (max 2)
scoreBuy  += (allowCross and emaCrossOver)  ? 2 : 0
scoreSell += (allowCross and emaCrossUnder) ? 2 : 0

// Sweep reclaim (max 2)
scoreBuy  += (allowSweep and sweepLow  and close > open and close >= emaFast) ? 2 : 0
scoreSell += (allowSweep and sweepHigh and close < open and close <= emaFast) ? 2 : 0

// MSS/BOS (max 2)
scoreBuy  += (allowMSS and (mssBuy  or bosBuy))  ? 2 : 0
scoreSell += (allowMSS and (mssSell or bosSell)) ? 2 : 0

// MSNR (max 3)
scoreBuy  += (useMSNR and msnrBuyOk)  ? 3 : 0
scoreSell += (useMSNR and msnrSellOk) ? 3 : 0

// LSDR (max 2)
scoreBuy  += lsdrBull ? 2 : 0
scoreSell += lsdrBear ? 2 : 0

// SMC-specific (max 3: smc dir, ob, cpr)
scoreBuy  += (smc_ms_bull_conf or sos_bull or mss_bull_s) ? 1 : 0
scoreSell += (smc_ms_bear_conf or sos_bear or mss_bear_s) ? 1 : 0
scoreBuy  += in_bull_ob ? 1 : 0
scoreSell += in_bear_ob ? 1 : 0
scoreBuy  += above_cpr  ? 1 : 0
scoreSell += below_cpr  ? 1 : 0

// Boosts (max 5: internals, liq-mag, vol-mag, killzone, macro bias)
boostBuy  = (proxiesOkBuy  ? 1:0) + (liq_mag_active ? 1:0) + (vol_mag_active ? 1:0) + (isKillzone ? 1:0) + (macroBull ? 1:0)
boostSell = (proxiesOkSell ? 1:0) + (liq_mag_active ? 1:0) + (vol_mag_active ? 1:0) + (isKillzone ? 1:0) + (macroBear ? 1:0)

// Raw total (unbounded — base max 26 + boosts max 5 = true max ~28-31)
rawScoreBuy  = scoreBuy  + boostBuy
rawScoreSell = scoreSell + boostSell

// Capped display score /15 (kept for backward compat with minScore input)
scoreBuyF  = int(math.min(15, rawScoreBuy))
scoreSellF = int(math.min(15, rawScoreSell))

// Normalised 0–100% and Grade
normScoreBuy  = int(math.min(100, math.round(rawScoreBuy  / float(scoreMaxRaw) * 100)))
normScoreSell = int(math.min(100, math.round(rawScoreSell / float(scoreMaxRaw) * 100)))

f_grade(n) =>
    n >= 85 ? "A+" : n >= 75 ? "A" : n >= 65 ? "B+" : n >= 55 ? "B" : n >= 45 ? "C+" : n >= 35 ? "C" : "D"

gradeBuy  = f_grade(normScoreBuy)
gradeSell = f_grade(normScoreSell)

macroMinScore = minScore + (useMacroEvents and boostScoreMacro and isMacroWin ? macroScoreBoost : 0)
macroBlk      = useMacroEvents and blockDuringMacro and isMacroWin

// ═══════════════════════════════════════════════════════════
// NO-CHASE / LATE ENTRY FILTER
// ═══════════════════════════════════════════════════════════
// Distance checks — how far price is from key references
distFromEmaFast  = math.abs(close - emaFast)
distFromVwap     = math.abs(close - vwapVal)
distFromMsnrSup  = not na(msnrSup) ? math.abs(close - msnrSup) : na
distFromMsnrRes  = not na(msnrRes) ? math.abs(close - msnrRes) : na
distFromMsnrBuy  = nz(distFromMsnrSup, atr * 99)
distFromMsnrSell = nz(distFromMsnrRes, atr * 99)

// Check if last candle was a big displacement (chasing after a spike)
lastCandleRange  = high[1] - low[1]
isPostDisp       = lastCandleRange > atr * chaseDispMult

// LATE flags
lateEma   = distFromEmaFast > atr * chaseEmaDistMult
lateVwap  = distFromVwap    > atr * chaseVwapDistMult
lateMsnr  = (isBullMS and distFromMsnrBuy > atr * chaseMsnrDistMult) or (isBearMS and distFromMsnrSell > atr * chaseMsnrDistMult)

isLateEntry = enableChaseFilter and (lateEma or lateVwap or lateMsnr or isPostDisp)
isFreshEntry = enableChaseFilter and not isLateEntry

// Entry quality string
entryQualTxt = not enableChaseFilter ? "FILTER OFF" : isPostDisp ? "NO CHASE 🚫" : isLateEntry ? "LATE ⚠️" : "FRESH ✅"
entryQualCol = not enableChaseFilter ? c_text_m : isPostDisp ? c_red : isLateEntry ? c_orange : c_green

// Score penalty for late entry (subtract 2 pts from capped score)
lateScorePenalty = (enableChaseFilter and isLateEntry and not chaseBlockLate) ? 2 : 0
scoreBuyF  := int(math.max(0, scoreBuyF  - lateScorePenalty))
scoreSellF := int(math.max(0, scoreSellF - lateScorePenalty))

// ═══════════════════════════════════════════════════════════
// OB PROXIMITY FILTER
// ═══════════════════════════════════════════════════════════
// Distance from current price to nearest opposing OB
// For BUY: distance to nearest bearish OB bottom (overhead supply)
// For SELL: distance to nearest bullish OB top (underlying demand)
distToBearOB = not na(ob_bear_bot) ? math.abs(ob_bear_bot - close) : atr * 99
distToBullOB = not na(ob_bull_top) ? math.abs(close - ob_bull_top) : atr * 99

obTooCloseBuy  = enableOBProxFilter and distToBearOB < atr * obProxAtrMult
obTooCloseSell = enableOBProxFilter and distToBullOB < atr * obProxAtrMult

obProxTxt = not enableOBProxFilter ? "FILTER OFF" : (obTooCloseBuy and isBullMS) ? "SUPPLY NEAR 🚫" : (obTooCloseSell and isBearMS) ? "DEMAND NEAR 🚫" : (distToBearOB < atr * obProxAtrMult * 2.5 and isBullMS) ? "SUPPLY CLOSE ⚠️" : (distToBullOB < atr * obProxAtrMult * 2.5 and isBearMS) ? "DEMAND CLOSE ⚠️" : "ROOM OK ✅"
obProxCol = not enableOBProxFilter ? c_text_m : (obTooCloseBuy and isBullMS) or (obTooCloseSell and isBearMS) ? c_red : str.contains(obProxTxt, "CLOSE") ? c_orange : c_green

// OB proximity penalty
obProxPenalty = (obProxPenalise and ((obTooCloseBuy and isBullMS) or (obTooCloseSell and isBearMS))) ? 2 : 0
scoreBuyF  := int(math.max(0, scoreBuyF  - (obTooCloseBuy  ? obProxPenalty : 0)))
scoreSellF := int(math.max(0, scoreSellF - (obTooCloseSell ? obProxPenalty : 0)))

// ═══════════════════════════════════════════════════════════
// ENTRY TYPE CLASSIFICATION
// ═══════════════════════════════════════════════════════════
c_aqua = color.aqua  // alias used in entryTypeCol
// Determine the primary reason for the signal (priority order)
entryTypeBuy  = (sweepLow and lsdrBull) ? "LQ BUY 💧" : (smc_choch_bull or mss_bull_s) ? "REV BUY 🔄" : msnrBuyOk ? "MSNR BUY 🎯" : (ctrBuyOk and impulseBull) ? "CTR BUY 📐" : (emaCrossOver and isBullMS) ? "PB BUY 📈" : (smc_bos_bull or bosBuy) ? "BD BUY ⚡" : "BUY"
entryTypeSell = (sweepHigh and lsdrBear) ? "LQ SELL 💧" : (smc_choch_bear or mss_bear_s) ? "REV SELL 🔄" : msnrSellOk ? "MSNR SELL 🎯" : (ctrSellOk and impulseBear) ? "CTR SELL 📐" : (emaCrossUnder and isBearMS) ? "PB SELL 📉" : (smc_bos_bear or bosSell) ? "BD SELL ⚡" : "SELL"
// entryTypeTxt and entryTypeCol computed after currentSig is declared (see DASHBOARD section)

// ═══════════════════════════════════════════════════════════
// TRADE STATE
// ═══════════════════════════════════════════════════════════
var string currentSig    = "Neutral"
var int    lastEntryBar  = -1000
var int    activeEntryBar = na

var float entryPrice  = na
var float exitPrice   = na
var float tp1         = na
var float tp2         = na
var float tp3         = na
var float tp4         = na
var float tp5         = na

var bool t1Hit = false
var bool t2Hit = false
var bool t3Hit = false
var bool t4Hit = false
var bool t5Hit = false
var bool alertConf = false

var bool   accuActive   = false
var string accuDir      = "Neutral"
var int    accuUntil    = 0
var float  accuEntry    = na
var float  accuSL       = na
var float  accuT1       = na
var float  accuT2       = na
var float  accuT3       = na
var float  accuT4       = na
var float  accuT5       = na

var float  revExitPrice  = na
var string revExitReason = ""
var box    bx_rev        = na
var label  lb_rev        = na
var bool   revDone       = false

var float  safeExPrice   = na
var string safeExReason  = ""
var box    bx_safe       = na
var label  lb_safe       = na
var bool   safeDone      = false

var float buyPad  = na
var float sellPad = na

bool buyEntryTrig    = false
bool sellEntryTrig   = false
bool slTrig          = false
bool tp1Trig         = false
bool tp2Trig         = false
bool tp3Trig         = false
bool tp4Trig         = false
bool tp5Trig         = false
bool revExitTrig     = false
bool safeExitTrig    = false
bool confRevBuy      = false
bool confRevSell     = false
bool padBrkBuy       = false
bool padBrkSell      = false

canEnter = (bar_index - lastEntryBar) >= minBarsGap

// ═══════════════════════════════════════════════════════════
// PROTECTION PAD
// ═══════════════════════════════════════════════════════════
f_padDist(_p) =>
    padMode == "ATR" ? atr * padAtrMult :
     padMode == "Points" ? padPoints * syminfo.mintick :
     _p * (padPercent / 100.0)

float padDist = f_padDist(close)

if enablePad and currentSig == "BUY" and alertConf
    buyPad  := entryPrice - padDist
    sellPad := na
else if enablePad and currentSig == "SELL" and alertConf
    sellPad := entryPrice + padDist
    buyPad  := na
else
    buyPad  := na
    sellPad := na

padBrkBuy  := enablePad and currentSig == "BUY"  and alertConf and not na(buyPad)  and low  <= buyPad
padBrkSell := enablePad and currentSig == "SELL" and alertConf and not na(sellPad) and high >= sellPad

// ═══════════════════════════════════════════════════════════
// RAW SIGNALS
// ═══════════════════════════════════════════════════════════
// Entry type allowed check (evaluated using same priority as entryTypeBuy/Sell)
f_etAllowBuy() =>
    _isLQ   = sweepLow and lsdrBull
    _isREV  = not _isLQ  and (smc_choch_bull or mss_bull_s)
    _isMSNR = not _isLQ  and not _isREV  and msnrBuyOk
    _isCTR  = not _isLQ  and not _isREV  and not _isMSNR and ctrBuyOk and impulseBull
    _isPB   = not _isLQ  and not _isREV  and not _isMSNR and not _isCTR and emaCrossOver and isBullMS
    _isBD   = not _isLQ  and not _isREV  and not _isMSNR and not _isCTR and not _isPB   and (smc_bos_bull or bosBuy)
    (_isLQ   and allowLQEntry)   or
     (_isREV  and allowREVEntry)  or
     (_isMSNR and allowMSNREntry) or
     (_isCTR  and allowCTREntry)  or
     (_isPB   and allowPBEntry)   or
     (_isBD   and allowBDEntry)   or
     (not _isLQ and not _isREV and not _isMSNR and not _isCTR and not _isPB and not _isBD and allowBaseEntry)

f_etAllowSell() =>
    _isLQ   = sweepHigh and lsdrBear
    _isREV  = not _isLQ  and (smc_choch_bear or mss_bear_s)
    _isMSNR = not _isLQ  and not _isREV  and msnrSellOk
    _isCTR  = not _isLQ  and not _isREV  and not _isMSNR and ctrSellOk and impulseBear
    _isPB   = not _isLQ  and not _isREV  and not _isMSNR and not _isCTR and emaCrossUnder and isBearMS
    _isBD   = not _isLQ  and not _isREV  and not _isMSNR and not _isCTR and not _isPB   and (smc_bos_bear or bosSell)
    (_isLQ   and allowLQEntry)   or
     (_isREV  and allowREVEntry)  or
     (_isMSNR and allowMSNREntry) or
     (_isCTR  and allowCTREntry)  or
     (_isPB   and allowPBEntry)   or
     (_isBD   and allowBDEntry)   or
     (not _isLQ and not _isREV and not _isMSNR and not _isCTR and not _isPB and not _isBD and allowBaseEntry)

// FIX: require confirmed trend alignment — isBullMS for BUY, isBearMS for SELL
// Previously only blocked opposite (not isBearMS), allowing entries in neutral/sideways
// NSE WINDOW: no new entries before 9:15 or at/after 15:00 IST
rawBuy  = inSession and inNSEWindow and scoreBuyF  >= macroMinScore and isBullMS  and (not hardBlockByInternals or not useIntNow or proxiesOkBuy)  and (not useMSNR or msnrBuyOk)  and ctrBuyOk  and not macroBlk and (not chaseBlockLate or not isLateEntry) and (not obProxHardBlock or not obTooCloseBuy)  and f_etAllowBuy()  and (not blockSideways or not isSideways) and (not candleBodyHardBlock or bodySufficient) and (not adxHardBlock or adxOk)
rawSell = inSession and inNSEWindow and scoreSellF >= macroMinScore and isBearMS  and (not hardBlockByInternals or not useIntNow or proxiesOkSell) and (not useMSNR or msnrSellOk) and ctrSellOk and not macroBlk and (not chaseBlockLate or not isLateEntry) and (not obProxHardBlock or not obTooCloseSell) and f_etAllowSell() and (not blockSideways or not isSideways) and (not candleBodyHardBlock or bodySufficient) and (not adxHardBlock or adxOk)

buySig  = entryOnClose ? rawBuy  and b_conf : rawBuy
sellSig = entryOnClose ? rawSell and b_conf : rawSell

bool buyFinal  = buySig
bool sellFinal = sellSig
if buySig and sellSig
    if scoreBuyF > scoreSellF
        sellFinal := false
    else if scoreSellF > scoreBuyF
        buyFinal := false
    else
        buyFinal  := false
        sellFinal := false

bool gBuy  = buyFinal
bool gSell = sellFinal

if enableAccuLock and accuActive
    if accuDir == "BUY"
        gSell := false
    if accuDir == "SELL"
        gBuy  := false

// ═══════════════════════════════════════════════════════════
// SAFE EXIT — precompute helpers
// ═══════════════════════════════════════════════════════════
buyTP1Now_s  = currentSig == "BUY"  and not na(tp1) and high >= tp1
buyTP2Now_s  = currentSig == "BUY"  and not na(tp2) and high >= tp2
buyTP3Now_s  = currentSig == "BUY"  and not na(tp3) and high >= tp3
sellTP1Now_s = currentSig == "SELL" and not na(tp1) and low  <= tp1
sellTP2Now_s = currentSig == "SELL" and not na(tp2) and low  <= tp2
sellTP3Now_s = currentSig == "SELL" and not na(tp3) and low  <= tp3

buyGate  = currentSig == "BUY"  and (safeExitAfterTP=="TP1" ? (t1Hit or buyTP1Now_s)  : safeExitAfterTP=="TP2" ? (t2Hit or buyTP2Now_s)  : (t3Hit or buyTP3Now_s))
sellGate = currentSig == "SELL" and (safeExitAfterTP=="TP1" ? (t1Hit or sellTP1Now_s) : safeExitAfterTP=="TP2" ? (t2Hit or sellTP2Now_s) : (t3Hit or sellTP3Now_s))

weakFlowBuy  = net_pressure <= -2 or buy_ratio_adv < 0.48
weakFlowSell = net_pressure >= 2  or buy_ratio_adv > 0.52

safeBearPress = currentSig == "BUY"  and (strongBearCdl or fastBearPress or (close < open and close < emaFast) or (not na(tp1) and high >= tp1 and close < open))
safeBullPress = currentSig == "SELL" and (strongBullCdl or fastBullPress or (close > open and close > emaFast) or (not na(tp1) and low  <= tp1 and close > open))

safeOppBuy  = showOnlyConfRev ? (sellFinal or (usePadSafe and padBrkBuy))  : (rawSell or safeBearPress or close < emaFast or (usePadSafe and padBrkBuy))
safeOppSell = showOnlyConfRev ? (buyFinal  or (usePadSafe and padBrkSell)) : (rawBuy  or safeBullPress or close > emaFast or (usePadSafe and padBrkSell))

safeCandBuy  = enableSafeExit and currentSig == "BUY"  and alertConf and not safeDone and bar_index > lastEntryBar and buyGate  and ((safeExitOnOppSignal and safeOppBuy)  or (safeExitOnWeakFlow and weakFlowBuy)  or (safeExitOnMacro and isMacroWin) or (usePadSafe and padBrkBuy))
safeCandSell = enableSafeExit and currentSig == "SELL" and alertConf and not safeDone and bar_index > lastEntryBar and sellGate and ((safeExitOnOppSignal and safeOppSell) or (safeExitOnWeakFlow and weakFlowSell) or (safeExitOnMacro and isMacroWin) or (usePadSafe and padBrkSell))

// ═══════════════════════════════════════════════════════════
// REVERSAL EXIT
// ═══════════════════════════════════════════════════════════
buySlDist  = currentSig == "BUY"  and not na(exitPrice) ? math.abs(close - exitPrice) : na
sellSlDist = currentSig == "SELL" and not na(exitPrice) ? math.abs(close - exitPrice) : na

buyTP2Now  = currentSig == "BUY"  and not na(tp2) and high >= tp2
buyTP3Now  = currentSig == "BUY"  and not na(tp3) and high >= tp3
sellTP2Now = currentSig == "SELL" and not na(tp2) and low  <= tp2
sellTP3Now = currentSig == "SELL" and not na(tp3) and low  <= tp3

nearSLBuy  = currentSig == "BUY"  and not na(exitPrice) and (low  <= exitPrice + atr*revNearSLAtrMult or buySlDist  <= atr*revNearSLAtrMult)
nearSLSell = currentSig == "SELL" and not na(exitPrice) and (high >= exitPrice - atr*revNearSLAtrMult or sellSlDist <= atr*revNearSLAtrMult)

revGateBuy  = currentSig == "BUY"  and (revExitAfterTarget=="TP2" ? (t2Hit or buyTP2Now)  : (t3Hit or buyTP3Now))
revGateSell = currentSig == "SELL" and (revExitAfterTarget=="TP2" ? (t2Hit or sellTP2Now) : (t3Hit or sellTP3Now))

oppForBuyATP  = showOnlyConfRev ? (sellFinal or (usePadRev and padBrkBuy))  : (rawSell or strongBearCdl or fastBearPress or close < emaFast or (usePadRev and padBrkBuy))
oppForSellATP = showOnlyConfRev ? (buyFinal  or (usePadRev and padBrkSell)) : (rawBuy  or strongBullCdl or fastBullPress or close > emaFast or (usePadRev and padBrkSell))
oppForBuySL   = rawSell or strongBearCdl or fastBearPress or close < emaFast or (usePadRev and padBrkBuy)
oppForSellSL  = rawBuy  or strongBullCdl or fastBullPress or close > emaFast or (usePadRev and padBrkSell)

tradeActive = currentSig != "Neutral" and alertConf

bool revExBuyATP  = tradeActive and exitOnOppSignal and currentSig=="BUY"  and bar_index>lastEntryBar and revGateBuy  and oppForBuyATP  and (strongBearCdl or fastBearPress or (usePadRev and padBrkBuy))  and not t5Hit
bool revExSellATP = tradeActive and exitOnOppSignal and currentSig=="SELL" and bar_index>lastEntryBar and revGateSell and oppForSellATP and (strongBullCdl or fastBullPress or (usePadRev and padBrkSell)) and not t5Hit

bool revExBuySL   = tradeActive and enableRevBeforeSL and currentSig=="BUY"  and bar_index>lastEntryBar and not revGateBuy  and nearSLBuy  and oppForBuySL  and (strongBearCdl or fastBearPress or close<emaFast or (usePadRev and padBrkBuy))  and not t5Hit
bool revExSellSL  = tradeActive and enableRevBeforeSL and currentSig=="SELL" and bar_index>lastEntryBar and not revGateSell and nearSLSell and oppForSellSL and (strongBullCdl or fastBullPress or close>emaFast or (usePadRev and padBrkSell)) and not t5Hit

bool revExBuy  = not revDone and (revExBuyATP  or revExBuySL)
bool revExSell = not revDone and (revExSellATP or revExSellSL)

if preferSafeOverRev
    revExBuy  := revExBuy  and not (safeCandBuy  and safeExitOnOppSignal and safeOppBuy)
    revExSell := revExSell and not (safeCandSell and safeExitOnOppSignal and safeOppSell)

bool flipToSell = flipOnRevExit and revExBuy  and scoreSellF >= flipMinScore
bool flipToBuy  = flipOnRevExit and revExSell and scoreBuyF  >= flipMinScore

// ─── helper: clear levels ───────────────────────────────
var line  l_entry  = na
var line  l_sl     = na
var line  l_t1     = na
var line  l_t2     = na
var line  l_t3     = na
var line  l_t4     = na
var line  l_t5     = na
var label lb_entry = na
var label lb_sl    = na
var label lb_t1    = na
var label lb_t2    = na
var label lb_t3    = na
var label lb_t4    = na
var label lb_t5    = na

// ─── INLINE HELPERS (Pine v6: cannot mutate globals inside UDFs) ───────────
// DEL_LEVELS — call site macro, inlined wherever needed
// CLEAR_TRADE — call site macro, inlined wherever needed
// DRAW_LEVELS — call site macro, inlined wherever needed
// OPEN_BUY / OPEN_SELL — call site macro, inlined wherever needed

// ═══════════════════════════════════════════════════════════
// ENTRIES
// ═══════════════════════════════════════════════════════════
if currentSig == "Neutral" and canEnter
    if gBuy
        // ── OPEN BUY ──
        currentSig     := "BUY"
        lastEntryBar   := bar_index
        activeEntryBar := bar_index
        entryPrice     := close
        exitPrice      := close - atr * atrSLmult
        tp1            := close + atr * t1mult
        tp2            := close + atr * t2mult
        tp3            := close + atr * t3mult
        tp4            := close + atr * t4mult
        tp5            := close + atr * t5mult
        t1Hit := false
        t2Hit := false
        t3Hit := false
        t4Hit := false
        t5Hit := false
        alertConf := true
        revDone := false
        safeDone := false
        box.delete(bx_rev)
        label.delete(lb_rev)
        bx_rev := na
        lb_rev := na
        revExitPrice := na
        revExitReason := ""
        box.delete(bx_safe)
        label.delete(lb_safe)
        bx_safe := na
        lb_safe := na
        safeExPrice := na
        safeExReason := ""
        buyPad := na
        sellPad := na
        if enableAccuLock and scoreBuyF >= accuLockMinScore
            accuActive := true
            accuDir := "BUY"
            accuUntil := bar_index + accuLockBars
            accuEntry := entryPrice
            accuSL := exitPrice
            accuT1 := tp1
            accuT2 := tp2
            accuT3 := tp3
            accuT4 := tp4
            accuT5 := tp5
        // ── DRAW LEVELS ──
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        _lx = nz(activeEntryBar, bar_index)
        _rx = bar_index + lineExtBars
        l_entry  := line.new(_lx, entryPrice, _rx, entryPrice, color=#FFD700, style=line.style_dashed, width=2)
        lb_entry := label.new(_rx, entryPrice, "EP " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=#FFD700, textcolor=color.black, size=size.tiny)
        l_sl     := line.new(_lx, exitPrice, _rx, exitPrice, color=#FF5252, style=line.style_solid, width=2)
        lb_sl    := label.new(_rx, exitPrice, "SL " + str.tostring(exitPrice, format.mintick), style=label.style_label_left, color=#FF5252, textcolor=color.white, size=size.tiny)
        l_t1     := line.new(_lx, tp1, _rx, tp1, color=#00E676, style=line.style_dotted, width=1)
        lb_t1    := label.new(_rx, tp1, "T1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t2     := line.new(_lx, tp2, _rx, tp2, color=#00E676, style=line.style_dotted, width=1)
        lb_t2    := label.new(_rx, tp2, "T2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t3     := line.new(_lx, tp3, _rx, tp3, color=#00E676, style=line.style_dotted, width=2)
        lb_t3    := label.new(_rx, tp3, "T3 " + str.tostring(tp3, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t4     := line.new(_lx, tp4, _rx, tp4, color=#FF00FF, style=line.style_solid, width=2)
        lb_t4    := label.new(_rx, tp4, "T4 " + str.tostring(tp4, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        l_t5     := line.new(_lx, tp5, _rx, tp5, color=#FF00FF, style=line.style_solid, width=2)
        lb_t5    := label.new(_rx, tp5, "T5 " + str.tostring(tp5, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        buyEntryTrig := true
        label.new(bar_index, low - atr*0.4,
             "▲ BUY " + str.tostring(scoreBuyF) + "/15\nEP " + str.tostring(math.round(entryPrice, 5)),
             color=color.new(color.teal,0), textcolor=color.white, style=label.style_label_up, size=size.tiny)
        if enableEntryAlerts
            alert('{"action":"BUY","symbol":"' + syminfo.ticker + '","ep":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(exitPrice, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + ',"score":' + str.tostring(scoreBuyF) + '}', alert.freq_once_per_bar)

    else if gSell
        // ── OPEN SELL ──
        currentSig     := "SELL"
        lastEntryBar   := bar_index
        activeEntryBar := bar_index
        entryPrice     := close
        exitPrice      := close + atr * atrSLmult
        tp1            := close - atr * t1mult
        tp2            := close - atr * t2mult
        tp3            := close - atr * t3mult
        tp4            := close - atr * t4mult
        tp5            := close - atr * t5mult
        t1Hit := false
        t2Hit := false
        t3Hit := false
        t4Hit := false
        t5Hit := false
        alertConf := true
        revDone := false
        safeDone := false
        box.delete(bx_rev)
        label.delete(lb_rev)
        bx_rev := na
        lb_rev := na
        revExitPrice := na
        revExitReason := ""
        box.delete(bx_safe)
        label.delete(lb_safe)
        bx_safe := na
        lb_safe := na
        safeExPrice := na
        safeExReason := ""
        buyPad := na
        sellPad := na
        if enableAccuLock and scoreSellF >= accuLockMinScore
            accuActive := true
            accuDir := "SELL"
            accuUntil := bar_index + accuLockBars
            accuEntry := entryPrice
            accuSL := exitPrice
            accuT1 := tp1
            accuT2 := tp2
            accuT3 := tp3
            accuT4 := tp4
            accuT5 := tp5
        // ── DRAW LEVELS ──
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        _lx = nz(activeEntryBar, bar_index)
        _rx = bar_index + lineExtBars
        l_entry  := line.new(_lx, entryPrice, _rx, entryPrice, color=#FFD700, style=line.style_dashed, width=2)
        lb_entry := label.new(_rx, entryPrice, "EP " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=#FFD700, textcolor=color.black, size=size.tiny)
        l_sl     := line.new(_lx, exitPrice, _rx, exitPrice, color=#FF5252, style=line.style_solid, width=2)
        lb_sl    := label.new(_rx, exitPrice, "SL " + str.tostring(exitPrice, format.mintick), style=label.style_label_left, color=#FF5252, textcolor=color.white, size=size.tiny)
        l_t1     := line.new(_lx, tp1, _rx, tp1, color=#00E676, style=line.style_dotted, width=1)
        lb_t1    := label.new(_rx, tp1, "T1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t2     := line.new(_lx, tp2, _rx, tp2, color=#00E676, style=line.style_dotted, width=1)
        lb_t2    := label.new(_rx, tp2, "T2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t3     := line.new(_lx, tp3, _rx, tp3, color=#00E676, style=line.style_dotted, width=2)
        lb_t3    := label.new(_rx, tp3, "T3 " + str.tostring(tp3, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t4     := line.new(_lx, tp4, _rx, tp4, color=#FF00FF, style=line.style_solid, width=2)
        lb_t4    := label.new(_rx, tp4, "T4 " + str.tostring(tp4, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        l_t5     := line.new(_lx, tp5, _rx, tp5, color=#FF00FF, style=line.style_solid, width=2)
        lb_t5    := label.new(_rx, tp5, "T5 " + str.tostring(tp5, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        sellEntryTrig := true
        label.new(bar_index, high + atr*0.4,
             "▼ SELL " + str.tostring(scoreSellF) + "/15\nEP " + str.tostring(math.round(entryPrice, 5)),
             color=color.new(color.red,0), textcolor=color.white, style=label.style_label_down, size=size.tiny)
        if enableEntryAlerts
            alert('{"action":"SELL","symbol":"' + syminfo.ticker + '","ep":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(exitPrice, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + ',"score":' + str.tostring(scoreSellF) + '}', alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════
// ACCU-LOCK MAINTAIN
// ═══════════════════════════════════════════════════════════
if enableAccuLock and accuActive
    if bar_index >= accuUntil
        accuActive := false
        accuDir    := "Neutral"
    entryPrice := accuEntry
    exitPrice  := accuSL
    tp1 := accuT1
    tp2 := accuT2
    tp3 := accuT3
    tp4 := accuT4
    tp5 := accuT5

// ═══════════════════════════════════════════════════════════
// REVERSAL EXIT EXECUTION
// ═══════════════════════════════════════════════════════════
if tradeActive and (revExBuy or revExSell)
    revExitTrig := true
    confRevBuy  := revExBuy
    confRevSell := revExSell
    revDone     := true
    revExitPrice := close

    if revExBuyATP
        revExitReason := "REV EXIT AFTER " + revExitAfterTarget + " + BEAR PRESS"
    else if revExSellATP
        revExitReason := "REV EXIT AFTER " + revExitAfterTarget + " + BULL PRESS"
    else if revExBuySL
        revExitReason := usePadRev and padBrkBuy  ? "FAST REV BEFORE SL + PAD" : "FAST REV BEFORE SL + BEAR"
    else if revExSellSL
        revExitReason := usePadRev and padBrkSell ? "FAST REV BEFORE SL + PAD" : "FAST REV BEFORE SL + BULL"

    if showRevArea
        box.delete(bx_rev)
        label.delete(lb_rev)
        bx_rev := box.new(bar_index, high, bar_index + revExitBoxBars, low, bgcolor=color.new(c_orange,85), border_color=c_orange, text="REV EXIT", text_color=c_orange, text_size=size.tiny)
        lb_rev := label.new(bar_index, close, "EXIT ⛔ " + str.tostring(revExitPrice, format.mintick), style=revExBuy ? label.style_label_down : label.style_label_up, color=c_orange, textcolor=color.black, size=size.small)

    // ── DEL LEVELS ──
    line.delete(l_entry)
    line.delete(l_sl)
    line.delete(l_t1)
    line.delete(l_t2)
    line.delete(l_t3)
    line.delete(l_t4)
    line.delete(l_t5)
    label.delete(lb_entry)
    label.delete(lb_sl)
    label.delete(lb_t1)
    label.delete(lb_t2)
    label.delete(lb_t3)
    label.delete(lb_t4)
    label.delete(lb_t5)
    // ── CLEAR TRADE ──
    buyPad := na
    sellPad := na
    if enableAccuLock
        accuActive := false
        accuDir := "Neutral"
    currentSig := "Neutral"
    alertConf := false

    if enableRevAlerts
        alert('{"action":"EXIT","reason":"REV_EXIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(revExitPrice, format.mintick) + '}', alert.freq_once_per_bar)

    if flipToSell
        // ── show exit marker for the closed BUY before opening SELL ──
        label.new(bar_index, revExitPrice, "✖ BUY EXIT @ " + str.tostring(revExitPrice, format.mintick),
             style=label.style_label_down, color=color.new(color.red, 0),
             textcolor=color.white, size=size.small)
        // ── OPEN SELL ──
        currentSig := "SELL"
        lastEntryBar := bar_index
        activeEntryBar := bar_index
        entryPrice := close
        exitPrice := close + atr * atrSLmult
        tp1 := close - atr * t1mult
        tp2 := close - atr * t2mult
        tp3 := close - atr * t3mult
        tp4 := close - atr * t4mult
        tp5 := close - atr * t5mult
        t1Hit := false
        t2Hit := false
        t3Hit := false
        t4Hit := false
        t5Hit := false
        alertConf := true
        revDone := false
        safeDone := false
        box.delete(bx_rev)
        label.delete(lb_rev)
        bx_rev := na
        lb_rev := na
        revExitPrice := na
        revExitReason := ""
        box.delete(bx_safe)
        label.delete(lb_safe)
        bx_safe := na
        lb_safe := na
        safeExPrice := na
        safeExReason := ""
        buyPad := na
        sellPad := na
        if enableAccuLock and scoreSellF >= accuLockMinScore
            accuActive := true
            accuDir := "SELL"
            accuUntil := bar_index + accuLockBars
            accuEntry := entryPrice
            accuSL := exitPrice
            accuT1 := tp1
            accuT2 := tp2
            accuT3 := tp3
            accuT4 := tp4
            accuT5 := tp5
        // ── DRAW LEVELS ──
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        _lx = nz(activeEntryBar, bar_index)
        _rx = bar_index + lineExtBars
        l_entry  := line.new(_lx, entryPrice, _rx, entryPrice, color=#FFD700, style=line.style_dashed, width=2)
        lb_entry := label.new(_rx, entryPrice, "EP " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=#FFD700, textcolor=color.black, size=size.tiny)
        l_sl     := line.new(_lx, exitPrice,  _rx, exitPrice,  color=#FF5252, style=line.style_solid,  width=2)
        lb_sl    := label.new(_rx, exitPrice,  "SL " + str.tostring(exitPrice,  format.mintick), style=label.style_label_left, color=#FF5252, textcolor=color.white, size=size.tiny)
        l_t1     := line.new(_lx, tp1, _rx, tp1, color=#00E676, style=line.style_dotted, width=1)
        lb_t1    := label.new(_rx, tp1, "T1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t2     := line.new(_lx, tp2, _rx, tp2, color=#00E676, style=line.style_dotted, width=1)
        lb_t2    := label.new(_rx, tp2, "T2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t3     := line.new(_lx, tp3, _rx, tp3, color=#00E676, style=line.style_dotted, width=2)
        lb_t3    := label.new(_rx, tp3, "T3 " + str.tostring(tp3, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t4     := line.new(_lx, tp4, _rx, tp4, color=#FF00FF, style=line.style_solid, width=2)
        lb_t4    := label.new(_rx, tp4, "T4 " + str.tostring(tp4, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        l_t5     := line.new(_lx, tp5, _rx, tp5, color=#FF00FF, style=line.style_solid, width=2)
        lb_t5    := label.new(_rx, tp5, "T5 " + str.tostring(tp5, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        sellEntryTrig := true
        label.new(bar_index, high + atr*0.5, "🔁 FLIP SELL", color=color.new(color.red,0), textcolor=color.white, style=label.style_label_down, size=size.small)
        if enableEntryAlerts
            alert('{"action":"FLIP_SELL","symbol":"' + syminfo.ticker + '","ep":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(exitPrice, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"score":' + str.tostring(scoreSellF) + '}', alert.freq_once_per_bar)

    else if flipToBuy
        // ── show exit marker for the closed SELL before opening BUY ──
        label.new(bar_index, revExitPrice, "✖ SELL EXIT @ " + str.tostring(revExitPrice, format.mintick),
             style=label.style_label_up, color=color.new(color.teal, 0),
             textcolor=color.white, size=size.small)
        // ── OPEN BUY ──
        currentSig := "BUY"
        lastEntryBar := bar_index
        activeEntryBar := bar_index
        entryPrice := close
        exitPrice := close - atr * atrSLmult
        tp1 := close + atr * t1mult
        tp2 := close + atr * t2mult
        tp3 := close + atr * t3mult
        tp4 := close + atr * t4mult
        tp5 := close + atr * t5mult
        t1Hit := false
        t2Hit := false
        t3Hit := false
        t4Hit := false
        t5Hit := false
        alertConf := true
        revDone := false
        safeDone := false
        box.delete(bx_rev)
        label.delete(lb_rev)
        bx_rev := na
        lb_rev := na
        revExitPrice := na
        revExitReason := ""
        box.delete(bx_safe)
        label.delete(lb_safe)
        bx_safe := na
        lb_safe := na
        safeExPrice := na
        safeExReason := ""
        buyPad := na
        sellPad := na
        if enableAccuLock and scoreBuyF >= accuLockMinScore
            accuActive := true
            accuDir := "BUY"
            accuUntil := bar_index + accuLockBars
            accuEntry := entryPrice
            accuSL := exitPrice
            accuT1 := tp1
            accuT2 := tp2
            accuT3 := tp3
            accuT4 := tp4
            accuT5 := tp5
        // ── DRAW LEVELS ──
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        _lx = nz(activeEntryBar, bar_index)
        _rx = bar_index + lineExtBars
        l_entry  := line.new(_lx, entryPrice, _rx, entryPrice, color=#FFD700, style=line.style_dashed, width=2)
        lb_entry := label.new(_rx, entryPrice, "EP " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=#FFD700, textcolor=color.black, size=size.tiny)
        l_sl     := line.new(_lx, exitPrice,  _rx, exitPrice,  color=#FF5252, style=line.style_solid,  width=2)
        lb_sl    := label.new(_rx, exitPrice,  "SL " + str.tostring(exitPrice,  format.mintick), style=label.style_label_left, color=#FF5252, textcolor=color.white, size=size.tiny)
        l_t1     := line.new(_lx, tp1, _rx, tp1, color=#00E676, style=line.style_dotted, width=1)
        lb_t1    := label.new(_rx, tp1, "T1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t2     := line.new(_lx, tp2, _rx, tp2, color=#00E676, style=line.style_dotted, width=1)
        lb_t2    := label.new(_rx, tp2, "T2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t3     := line.new(_lx, tp3, _rx, tp3, color=#00E676, style=line.style_dotted, width=2)
        lb_t3    := label.new(_rx, tp3, "T3 " + str.tostring(tp3, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
        l_t4     := line.new(_lx, tp4, _rx, tp4, color=#FF00FF, style=line.style_solid, width=2)
        lb_t4    := label.new(_rx, tp4, "T4 " + str.tostring(tp4, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        l_t5     := line.new(_lx, tp5, _rx, tp5, color=#FF00FF, style=line.style_solid, width=2)
        lb_t5    := label.new(_rx, tp5, "T5 " + str.tostring(tp5, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
        buyEntryTrig := true
        label.new(bar_index, low - atr*0.5, "🔁 FLIP BUY", color=color.new(color.lime,0), textcolor=color.black, style=label.style_label_up, size=size.small)
        if enableEntryAlerts
            alert('{"action":"FLIP_BUY","symbol":"' + syminfo.ticker + '","ep":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(exitPrice, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"score":' + str.tostring(scoreBuyF) + '}', alert.freq_once_per_bar)

plotshape(showRevPoints and confRevBuy  and revPointStyle=="Dot",   style=shape.circle,       location=location.abovebar, color=c_red,   size=size.tiny, text="R")
plotshape(showRevPoints and confRevBuy  and revPointStyle=="Arrow", style=shape.triangledown, location=location.abovebar, color=c_red,   size=size.tiny, text="R")
plotshape(showRevPoints and confRevSell and revPointStyle=="Dot",   style=shape.circle,       location=location.belowbar, color=c_green, size=size.tiny, text="R")
plotshape(showRevPoints and confRevSell and revPointStyle=="Arrow", style=shape.triangleup,   location=location.belowbar, color=c_green, size=size.tiny, text="R")

// ═══════════════════════════════════════════════════════════
// SAFE EXIT EXECUTION
// ═══════════════════════════════════════════════════════════
if safeCandBuy or safeCandSell
    safeExitTrig := true
    safeDone     := true
    safeExPrice  := close

    if safeCandBuy
        safeExReason := usePadSafe and padBrkBuy ? "SAFE EXIT: PAD" : safeExitOnMacro and isMacroWin ? "SAFE EXIT: MACRO" : safeExitOnOppSignal and safeOppBuy ? "SAFE EXIT: OPP SIGNAL" : "SAFE EXIT: WEAK FLOW"
    else
        safeExReason := usePadSafe and padBrkSell ? "SAFE EXIT: PAD" : safeExitOnMacro and isMacroWin ? "SAFE EXIT: MACRO" : safeExitOnOppSignal and safeOppSell ? "SAFE EXIT: OPP SIGNAL" : "SAFE EXIT: WEAK FLOW"

    // ── EXIT LABEL: always visible regardless of showSafeArea ──
    if safeCandBuy
        label.new(bar_index, safeExPrice, "✖ BUY EXIT @ " + str.tostring(safeExPrice, format.mintick),
             style=label.style_label_down, color=color.new(color.red, 0),
             textcolor=color.white, size=size.small)
    else
        label.new(bar_index, safeExPrice, "✖ SELL EXIT @ " + str.tostring(safeExPrice, format.mintick),
             style=label.style_label_up, color=color.new(color.teal, 0),
             textcolor=color.white, size=size.small)

    if showSafeArea
        box.delete(bx_safe)
        label.delete(lb_safe)
        bx_safe := box.new(bar_index, high, bar_index + safeExitBoxBars, low, bgcolor=color.new(c_blue,86), border_color=c_blue, text="SAFE EXIT", text_color=c_blue, text_size=size.tiny)
        lb_safe := label.new(bar_index, close, "SAFE 🛡 " + str.tostring(safeExPrice, format.mintick), style=safeCandBuy ? label.style_label_down : label.style_label_up, color=c_blue, textcolor=color.white, size=size.small)

    // ── DEL LEVELS ──
    line.delete(l_entry)
    line.delete(l_sl)
    line.delete(l_t1)
    line.delete(l_t2)
    line.delete(l_t3)
    line.delete(l_t4)
    line.delete(l_t5)
    label.delete(lb_entry)
    label.delete(lb_sl)
    label.delete(lb_t1)
    label.delete(lb_t2)
    label.delete(lb_t3)
    label.delete(lb_t4)
    label.delete(lb_t5)
    // ── CLEAR TRADE ──
    buyPad := na
    sellPad := na
    if enableAccuLock
        accuActive := false
        accuDir := "Neutral"
    currentSig := "Neutral"
    alertConf := false

    if enableSafeAlerts
        alert('{"action":"EXIT","reason":"SAFE_EXIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(safeExPrice, format.mintick) + '}', alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════
// NSE 3:00 PM FORCE EXIT
// Close any open trade at market close to avoid overnight/carry risk
// ═══════════════════════════════════════════════════════════
if isNSECloseBar and currentSig != "Neutral" and alertConf
    label.new(bar_index, close, "🕔 3PM EXIT @ " + str.tostring(close, format.mintick),
         color=color.new(color.orange, 0), textcolor=color.white,
         style=currentSig == "BUY" ? label.style_label_down : label.style_label_up,
         size=size.small)
    line.delete(l_entry)
    line.delete(l_sl)
    line.delete(l_t1)
    line.delete(l_t2)
    line.delete(l_t3)
    line.delete(l_t4)
    line.delete(l_t5)
    label.delete(lb_entry)
    label.delete(lb_sl)
    label.delete(lb_t1)
    label.delete(lb_t2)
    label.delete(lb_t3)
    label.delete(lb_t4)
    label.delete(lb_t5)
    buyPad  := na
    sellPad := na
    if enableAccuLock
        accuActive := false
        accuDir    := "Neutral"
    currentSig := "Neutral"
    alertConf  := false
    alert('{"action":"EXIT","reason":"EOD_3PM","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close, format.mintick) + '}', alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════
// TP / SL TRACKING
// ═══════════════════════════════════════════════════════════
if currentSig == "BUY" and alertConf and bar_index > lastEntryBar
    if not t1Hit and high >= tp1
        t1Hit    := true
        tp1Trig  := true
        label.new(bar_index, tp1, "T1 ✓", color=color.new(color.yellow,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t1Hit and not t2Hit and high >= tp2
        t2Hit    := true
        tp2Trig  := true
        label.new(bar_index, tp2, "T2 ✓", color=color.new(color.lime,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t2Hit and not t3Hit and high >= tp3
        t3Hit    := true
        tp3Trig  := true
        exitPrice := tp2
        line.set_y1(l_sl, exitPrice)
        line.set_y2(l_sl, exitPrice)
        label.set_y(lb_sl, exitPrice)
        label.set_text(lb_sl, "SL " + str.tostring(exitPrice, format.mintick))
        label.new(bar_index, tp3, "T3 ✓", color=color.new(color.lime,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t3Hit and not t4Hit and high >= tp4
        t4Hit    := true
        tp4Trig  := true
        label.new(bar_index, tp4, "T4 ✓", color=color.new(color.aqua,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t4Hit and not t5Hit and high >= tp5
        t5Hit    := true
        tp5Trig  := true
        label.new(bar_index, tp5, "T5 🏆", color=color.new(color.aqua,0), textcolor=color.black, style=label.style_label_right, size=size.small)
        label.new(bar_index, tp5, "✖ BUY EXIT @ " + str.tostring(tp5, format.mintick),
             style=label.style_label_down, color=color.new(color.green, 0),
             textcolor=color.white, size=size.small)
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        buyPad := na
        sellPad := na
        if enableAccuLock and accuUnlockOnT5
            accuActive := false
            accuDir := "Neutral"
        currentSig := "Neutral"
        alertConf := false
    if low <= exitPrice and currentSig == "BUY"
        slTrig := true
        label.new(bar_index, low - atr * 0.3, "❌ BUY SL " + str.tostring(exitPrice, format.mintick),
             color=color.new(color.red, 0), textcolor=color.white,
             style=label.style_label_up, size=size.small)
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        buyPad := na
        sellPad := na
        if enableAccuLock and accuUnlockOnSL
            accuActive := false
            accuDir := "Neutral"
        currentSig := "Neutral"
        alertConf := false

if currentSig == "SELL" and alertConf and bar_index > lastEntryBar
    if not t1Hit and low <= tp1
        t1Hit    := true
        tp1Trig  := true
        label.new(bar_index, tp1, "T1 ✓", color=color.new(color.yellow,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t1Hit and not t2Hit and low <= tp2
        t2Hit    := true
        tp2Trig  := true
        label.new(bar_index, tp2, "T2 ✓", color=color.new(color.lime,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t2Hit and not t3Hit and low <= tp3
        t3Hit    := true
        tp3Trig  := true
        exitPrice := tp2
        line.set_y1(l_sl, exitPrice)
        line.set_y2(l_sl, exitPrice)
        label.set_y(lb_sl, exitPrice)
        label.set_text(lb_sl, "SL " + str.tostring(exitPrice, format.mintick))
        label.new(bar_index, tp3, "T3 ✓", color=color.new(color.lime,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t3Hit and not t4Hit and low <= tp4
        t4Hit    := true
        tp4Trig  := true
        label.new(bar_index, tp4, "T4 ✓", color=color.new(color.aqua,0), textcolor=color.black, style=label.style_label_right, size=size.tiny)
    if t4Hit and not t5Hit and low <= tp5
        t5Hit    := true
        tp5Trig  := true
        label.new(bar_index, tp5, "T5 🏆", color=color.new(color.aqua,0), textcolor=color.black, style=label.style_label_right, size=size.small)
        label.new(bar_index, tp5, "✖ SELL EXIT @ " + str.tostring(tp5, format.mintick),
             style=label.style_label_up, color=color.new(color.green, 0),
             textcolor=color.white, size=size.small)
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        buyPad := na
        sellPad := na
        if enableAccuLock and accuUnlockOnT5
            accuActive := false
            accuDir := "Neutral"
        currentSig := "Neutral"
        alertConf := false
    if high >= exitPrice and currentSig == "SELL"
        slTrig := true
        label.new(bar_index, high + atr * 0.3, "❌ SELL SL " + str.tostring(exitPrice, format.mintick),
             color=color.new(color.red, 0), textcolor=color.white,
             style=label.style_label_down, size=size.small)
        line.delete(l_entry)
        line.delete(l_sl)
        line.delete(l_t1)
        line.delete(l_t2)
        line.delete(l_t3)
        line.delete(l_t4)
        line.delete(l_t5)
        label.delete(lb_entry)
        label.delete(lb_sl)
        label.delete(lb_t1)
        label.delete(lb_t2)
        label.delete(lb_t3)
        label.delete(lb_t4)
        label.delete(lb_t5)
        buyPad := na
        sellPad := na
        if enableAccuLock and accuUnlockOnSL
            accuActive := false
            accuDir := "Neutral"
        currentSig := "Neutral"
        alertConf := false

// ═══════════════════════════════════════════════════════════
// DRAW ACTIVE LEVELS (live update each bar)
// ═══════════════════════════════════════════════════════════
if (currentSig == "BUY" or currentSig == "SELL") and alertConf
    line.delete(l_entry)
    line.delete(l_sl)
    line.delete(l_t1)
    line.delete(l_t2)
    line.delete(l_t3)
    line.delete(l_t4)
    line.delete(l_t5)
    label.delete(lb_entry)
    label.delete(lb_sl)
    label.delete(lb_t1)
    label.delete(lb_t2)
    label.delete(lb_t3)
    label.delete(lb_t4)
    label.delete(lb_t5)
    _lx = nz(activeEntryBar, bar_index)
    _rx = bar_index + lineExtBars
    l_entry  := line.new(_lx, entryPrice, _rx, entryPrice, color=#FFD700, style=line.style_dashed, width=2)
    lb_entry := label.new(_rx, entryPrice, "EP " + str.tostring(entryPrice, format.mintick), style=label.style_label_left, color=#FFD700, textcolor=color.black, size=size.tiny)
    l_sl     := line.new(_lx, exitPrice,  _rx, exitPrice,  color=#FF5252, style=line.style_solid,  width=2)
    lb_sl    := label.new(_rx, exitPrice,  "SL " + str.tostring(exitPrice,  format.mintick), style=label.style_label_left, color=#FF5252, textcolor=color.white, size=size.tiny)
    l_t1     := line.new(_lx, tp1, _rx, tp1, color=#00E676, style=line.style_dotted, width=1)
    lb_t1    := label.new(_rx, tp1, "T1 " + str.tostring(tp1, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
    l_t2     := line.new(_lx, tp2, _rx, tp2, color=#00E676, style=line.style_dotted, width=1)
    lb_t2    := label.new(_rx, tp2, "T2 " + str.tostring(tp2, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
    l_t3     := line.new(_lx, tp3, _rx, tp3, color=#00E676, style=line.style_dotted, width=2)
    lb_t3    := label.new(_rx, tp3, "T3 " + str.tostring(tp3, format.mintick), style=label.style_label_left, color=#00E676, textcolor=color.black, size=size.tiny)
    l_t4     := line.new(_lx, tp4, _rx, tp4, color=#FF00FF, style=line.style_solid, width=2)
    lb_t4    := label.new(_rx, tp4, "T4 " + str.tostring(tp4, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
    l_t5     := line.new(_lx, tp5, _rx, tp5, color=#FF00FF, style=line.style_solid, width=2)
    lb_t5    := label.new(_rx, tp5, "T5 " + str.tostring(tp5, format.mintick), style=label.style_label_left, color=#FF00FF, textcolor=color.white, size=size.tiny)
else
    line.delete(l_entry)
    line.delete(l_sl)
    line.delete(l_t1)
    line.delete(l_t2)
    line.delete(l_t3)
    line.delete(l_t4)
    line.delete(l_t5)
    label.delete(lb_entry)
    label.delete(lb_sl)
    label.delete(lb_t1)
    label.delete(lb_t2)
    label.delete(lb_t3)
    label.delete(lb_t4)
    label.delete(lb_t5)

// TP ALERTS
if b_conf
    if tp1Trig and enableTPAlerts
        alert('{"action":"TP1_HIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(tp1, format.mintick) + '}', alert.freq_once_per_bar)
    if tp2Trig and enableTPAlerts
        alert('{"action":"TP2_HIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(tp2, format.mintick) + '}', alert.freq_once_per_bar)
    if tp3Trig and enableTPAlerts
        alert('{"action":"TP3_HIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(tp3, format.mintick) + '}', alert.freq_once_per_bar)
    if tp4Trig and enableTPAlerts
        alert('{"action":"TP4_HIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(tp4, format.mintick) + '}', alert.freq_once_per_bar)
    if tp5Trig and enableTPAlerts
        alert('{"action":"TP5_HIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(tp5, format.mintick) + '}', alert.freq_once_per_bar)
    if slTrig and enableSLAlerts
        alert('{"action":"SL_HIT","symbol":"' + syminfo.ticker + '","price":' + str.tostring(exitPrice, format.mintick) + '}', alert.freq_once_per_bar)
    if enablePadAlerts and padBrkBuy
        alert('{"action":"PAD_BREAK","side":"BUY","symbol":"' + syminfo.ticker + '","price":' + str.tostring(buyPad, format.mintick) + '}', alert.freq_once_per_bar)
    if enablePadAlerts and padBrkSell
        alert('{"action":"PAD_BREAK","side":"SELL","symbol":"' + syminfo.ticker + '","price":' + str.tostring(sellPad, format.mintick) + '}', alert.freq_once_per_bar)

// ═══════════════════════════════════════════════════════════
// MICRO DANGER WINDOW (SMC)
// ═══════════════════════════════════════════════════════════
near_sl_now = (currentSig == "BUY" and not na(exitPrice) and close > exitPrice and (close - exitPrice) < atr * 0.4) or (currentSig == "SELL" and not na(exitPrice) and close < exitPrice and (exitPrice - close) < atr * 0.4)
micro_danger = micro_doji and near_sl_now
bgcolor(micro_danger ? color.new(color.purple, 88) : na, title="Micro Danger")

// ═══════════════════════════════════════════════════════════
// SWEEP BOXES + MAGNET TAGS
// ═══════════════════════════════════════════════════════════
if showSweepBoxes and canDrawRecent
    if sweepLow
        box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=color.new(c_green,90), border_color=c_green, text="LIQ SWEEP", text_size=size.tiny, text_color=c_green)
    if sweepHigh
        box.new(bar_index-1, high[1], bar_index, low[1], bgcolor=color.new(c_red,90), border_color=c_red, text="LIQ SWEEP", text_size=size.tiny, text_color=c_red)

if showMagnetTags and canDrawRecent and (liq_mag_active or vol_mag_active)
    tag = (liq_mag_active ? "LIQ🧲 " : "") + (vol_mag_active ? "VOL🚀 " : "") + (aia_active ? "AIA💎" : "")
    sy  = currentSig == "SELL" ? high : low
    st  = currentSig == "SELL" ? label.style_label_down : label.style_label_up
    label.new(bar_index, sy, tag, color=color.new(#FFD700,10), textcolor=color.black, style=st, size=size.tiny)

// ═══════════════════════════════════════════════════════════
// DELTA TINT
// ═══════════════════════════════════════════════════════════
buyVol_e  = close > open ? volume : 0.0
sellVol_e = close < open ? volume : 0.0
dlt       = buyVol_e - sellVol_e
dltNorm   = volume > 0 ? dlt / volume : 0.0
barcolor(showDeltaTint ? (dltNorm > 0 ? color.new(c_green,75) : dltNorm < 0 ? color.new(c_red,75) : na) : na, title="Delta Tint")

// Entry / exit bar color
barcolor(buyEntryTrig  ? color.new(color.teal,0)   : na, title="Buy Entry Bar")
barcolor(sellEntryTrig ? color.new(color.red,0)    : na, title="Sell Entry Bar")
barcolor(safeExitTrig  ? color.new(color.yellow,0) : na, title="Safe Exit Bar")
barcolor(micro_danger  ? color.new(color.purple,0) : na, title="Danger Bar")

// ═══════════════════════════════════════════════════════════
// MACRO WINDOW MARKERS
// ═══════════════════════════════════════════════════════════
plotshape(isFomcWin, style=shape.labeldown, location=location.abovebar, color=color.orange,  text="FOMC", textcolor=color.black, size=size.tiny)
plotshape(isNfpWin,  style=shape.labeldown, location=location.abovebar, color=color.yellow,  text="NFP",  textcolor=color.black, size=size.tiny)
plotshape(isCpiWin,  style=shape.labeldown, location=location.abovebar, color=color.aqua,    text="CPI",  textcolor=color.black, size=size.tiny)
plotshape(isPpiWin,  style=shape.labeldown, location=location.abovebar, color=color.fuchsia, text="PPI",  textcolor=color.black, size=size.tiny)

// ═══════════════════════════════════════════════════════════
// PLOTS — EMA / VWAP / CPR / MSNR / CTR / PAD
// ═══════════════════════════════════════════════════════════
plot(emaFast, "EMA Fast",    color=color.new(color.green,0),  linewidth=1)
plot(emaSlow, "EMA Slow",    color=color.new(color.red,0),    linewidth=2)
plot(ema200,  "EMA 200",     color=color.new(color.white,0),  linewidth=2)
plot(vwapVal, "VWAP",        color=color.new(color.yellow,0), linewidth=2)
plot(showCPR ? cpr_pivot : na, "Pivot", color=color.new(color.white,55), linewidth=1, style=plot.style_cross)
plot(showCPR ? cpr_tc    : na, "TC",    color=color.new(color.teal,45),  linewidth=1)
plot(showCPR ? cpr_bc    : na, "BC",    color=color.new(color.teal,45),  linewidth=1)
plot(showMSNR ? msnrSup  : na, "MSNR Sup",  color=color.new(color.lime,0),   linewidth=2, style=plot.style_linebr)
plot(showMSNR ? msnrRes  : na, "MSNR Res",  color=color.new(color.red,0),    linewidth=2, style=plot.style_linebr)
plot(showCTRLevels ? ctrBullMid : na, "CTR Bull Mid", color=color.new(color.aqua,0),   linewidth=1, style=plot.style_linebr)
plot(showCTRLevels ? ctrBearMid : na, "CTR Bear Mid", color=color.new(color.orange,0), linewidth=1, style=plot.style_linebr)
plot(showPadLines ? buyPad  : na, "Buy Pad",  color=color.new(color.lime,0), linewidth=2, style=plot.style_linebr)
plot(showPadLines ? sellPad : na, "Sell Pad", color=color.new(color.red,0),  linewidth=2, style=plot.style_linebr)

// ═══════════════════════════════════════════════════════════
// SYSTEM HEALTH
// ═══════════════════════════════════════════════════════════
healthScore = 0
healthScore += inSession                                                   ? 1 : 0
healthScore += not isSideways                                              ? 1 : 0
healthScore += (proxiesOkBuy or proxiesOkSell)                            ? 1 : 0
healthScore += (not useMacroEvents or not isMacroWin)                     ? 1 : 0
healthScore += (buy_vol_alert or sell_vol_alert)                          ? 1 : 0
healthScore += (liq_mag_active or vol_mag_active)                         ? 1 : 0
healthScore += (msnrBuyOk or msnrSellOk or nearMSNRSup or nearMSNRRes)   ? 1 : 0

healthTxt  = healthScore >= 6 ? "STRONG" : healthScore >= 4 ? "NORMAL" : "WEAK"
healthCol  = healthScore >= 6 ? c_green  : healthScore >= 4 ? c_orange  : c_red
healthPct  = int(math.round(healthScore / 7.0 * 100))

// ═══════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════
// Entry type txt/col — needs currentSig which is now declared
entryTypeTxt = currentSig == "BUY" ? entryTypeBuy : currentSig == "SELL" ? entryTypeSell : isBullMS ? entryTypeBuy : isBearMS ? entryTypeSell : "—"
entryTypeCol = str.contains(entryTypeTxt, "LQ") ? c_blue : str.contains(entryTypeTxt, "REV") ? c_orange : str.contains(entryTypeTxt, "MSNR") ? c_green : str.contains(entryTypeTxt, "CTR") ? c_aqua : str.contains(entryTypeTxt, "PB") ? c_green : str.contains(entryTypeTxt, "BD") ? c_purple : c_text_m
liveScore  = currentSig == "Neutral" ? math.max(scoreBuyF, scoreSellF) : currentSig == "BUY" ? scoreBuyF : scoreSellF
sigCol2    = currentSig == "BUY" ? c_green : currentSig == "SELL" ? c_red : c_text_m
sigTxt2    = currentSig == "BUY" ? "🟢 LONG" : currentSig == "SELL" ? "🔴 SHORT" : "⏳ WAIT"
confCol2   = liveScore >= 12 ? c_green : liveScore >= 8 ? c_orange : c_red

t_active   = currentSig != "Neutral" and alertConf
string nextTPName = "—"
float  nextTPPrice = na
if t_active
    if not t1Hit
        nextTPName  := "T1"
        nextTPPrice := tp1
    else if not t2Hit
        nextTPName  := "T2"
        nextTPPrice := tp2
    else if not t3Hit
        nextTPName  := "T3"
        nextTPPrice := tp3
    else if not t4Hit
        nextTPName  := "T4"
        nextTPPrice := tp4
    else if not t5Hit
        nextTPName  := "T5"
        nextTPPrice := tp5
    else
        nextTPName  := "DONE"
        nextTPPrice := na

nextTPTxt = not t_active ? "—" : nextTPName == "DONE" ? "✅ ALL HIT" : nextTPName + " → " + str.tostring(nextTPPrice, format.mintick)
nextTPCol = not t_active ? c_text_m : nextTPName == "DONE" ? c_green : c_orange

tgtStr = t5Hit ? "5/5 MAX" : t4Hit ? "4/5 STRONG" : t3Hit ? "3/5 GOOD" : t2Hit ? "2/5 BUILD" : t1Hit ? "1/5 START" : "NO HITS"
tgtCol = t5Hit ? c_purple : t4Hit ? c_green : t3Hit ? c_green : t2Hit ? c_orange : t1Hit ? c_orange : c_red

bankFlowTxt = net_pressure > 10 ? "BUY FLOW ↑" : net_pressure < -10 ? "SELL FLOW ↓" : "NEUTRAL"
bankFlowCol = net_pressure > 10 ? c_green : net_pressure < -10 ? c_red : c_text_m

msnrDshTxt = msnrBuyOk ? "BUY ZONE ✅" : msnrSellOk ? "SELL ZONE ✅" : nearMSNRSup ? "SUP TEST" : nearMSNRRes ? "RES TEST" : "—"
msnrDshCol = msnrBuyOk ? c_green : msnrSellOk ? c_red : (nearMSNRSup or nearMSNRRes) ? c_orange : c_text_m

ctrDshTxt = not enableCTR ? "OFF" : ctrBuyOk ? "BUY ✅" : ctrSellOk ? "SELL ✅" : "WAIT"
ctrDshCol = not enableCTR ? c_text_m : ctrBuyOk ? c_green : ctrSellOk ? c_red : c_orange

sosmssTxt = (sos_bull or mss_bull_s) ? "BULL ✓" : (sos_bear or mss_bear_s) ? "BEAR ✓" : "—"
sosmssCol = (sos_bull or mss_bull_s) ? c_green  : (sos_bear or mss_bear_s) ? c_red : c_text_m

obTxt = in_bull_ob ? "BULL OB" : in_bear_ob ? "BEAR OB" : "—"
obCol = in_bull_ob ? c_green   : in_bear_ob ? c_red     : c_text_m

cprTxt = above_cpr ? "ABOVE ▲" : below_cpr ? "BELOW ▼" : "IN CPR"
cprCol = above_cpr ? c_green   : below_cpr ? c_red      : c_orange

macroStatTxt = not useMacroEvents ? "OFF" : isMacroWin ? ("LIVE " + macroEvtName) : "CLEAR"
macroStatCol = not useMacroEvents ? c_text_m : isMacroWin ? c_red : c_green

revDshTxt = revExitReason == "" ? "NONE" : revExitReason
safeExDshTxt = safeExReason == "" ? "OFF / WAIT" : safeExReason

padDshTxt = not enablePad ? "OFF" : currentSig=="BUY" and not na(buyPad) ? "BUY PAD " + str.tostring(buyPad, format.mintick) : currentSig=="SELL" and not na(sellPad) ? "SELL PAD " + str.tostring(sellPad, format.mintick) : "WAIT"
padDshCol = not enablePad ? c_text_m : (padBrkBuy or padBrkSell) ? c_red : currentSig=="BUY" ? c_green : currentSig=="SELL" ? c_red : c_text_m

aiPct = int(math.min(99, math.round(liveScore / 15.0 * 100)))
aiTxt = str.tostring(aiPct) + "%"
aiCol = aiPct >= 70 ? c_green : aiPct >= 45 ? c_orange : c_red

// Real score engine display values
liveRaw  = currentSig == "BUY" ? rawScoreBuy : currentSig == "SELL" ? rawScoreSell : math.max(rawScoreBuy, rawScoreSell)
liveNorm = currentSig == "BUY" ? normScoreBuy : currentSig == "SELL" ? normScoreSell : math.max(normScoreBuy, normScoreSell)
liveGrade = currentSig == "BUY" ? gradeBuy : currentSig == "SELL" ? gradeSell : (normScoreBuy >= normScoreSell ? gradeBuy : gradeSell)
rawScoreTxt  = str.tostring(liveRaw) + " raw / " + str.tostring(liveNorm) + "%"
rawScoreCol  = liveNorm >= 75 ? c_green : liveNorm >= 50 ? c_orange : c_red
gradeTxt     = liveGrade
gradeCol     = str.contains(liveGrade,"A") ? c_green : str.contains(liveGrade,"B") ? c_orange : c_red

var table fd = table.new(dash_loc, 2, 54,
     bgcolor=c_bg, border_color=color.new(color.gray,55), border_width=1,
     frame_color=color.new(color.gray,40), frame_width=1)

f_row(r, l, v, vc) =>
    table.cell(fd, 0, r, l, bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(fd, 1, r, v, bgcolor=c_bg, text_color=vc,     text_size=d_sz, text_halign=text.align_right)
f_hdr(r, t) =>
    table.cell(fd, 0, r, t, bgcolor=c_bg_hdr, text_color=c_text, text_size=d_sz, text_halign=text.align_center)
    table.cell(fd, 1, r, "",bgcolor=c_bg_hdr, text_color=c_text, text_size=d_sz)
    table.merge_cells(fd, 0, r, 1, r)

if b_last and showDashboard
    table.clear(fd, 0, 0, 1, 53)
    f_hdr(0,  currentSig=="SELL" ? "SMC TM SUPREME v6.1 • SELL" : currentSig=="BUY" ? "SMC TM SUPREME v6.1 • BUY" : "SMC TM SUPREME v6.1")
    f_row(1,  "SIGNAL",       sigTxt2,   sigCol2)
    f_row(2,  "ENTRY TYPE",   entryTypeTxt, entryTypeCol)
    f_row(3,  "ENTRY QUALITY",entryQualTxt, entryQualCol)
    f_row(4,  "OB PROXIMITY", obProxTxt, obProxCol)
    f_row(5,  "MODE",         enableAccuLock ? "ACCU-LOCK 💎" : "STANDARD",  enableAccuLock ? c_blue : c_text_m)
    f_row(6,  "SESSION",      inSession ? "OPEN" : "CLOSED", inSession ? c_green : c_red)
    f_row(7,  "NSE WINDOW",   inNSEWindow ? "ACTIVE ⏱" : "CLOSED 🚫", inNSEWindow ? c_green : c_orange)
    f_hdr(8,  "SCORE ENGINE")
    f_row(9,  "RAW SCORE",    rawScoreTxt, rawScoreCol)
    f_row(10, "GRADE",        gradeTxt,    gradeCol)
    f_row(11, "CAPPED /15",   str.tostring(liveScore) + "/15", confCol2)
    f_row(12, "AI CONF",      aiTxt, aiCol)
    f_hdr(13, "MARKET CONTEXT")
    f_row(14, "STRUCTURE",    msText, msCol)
    f_row(15, "ADX TREND",    adxTxt, adxCol)
    f_row(16, "SMC DIR",      smc_dir, smc_ms_bull ? c_green : smc_ms_bear ? c_red : c_orange)
    f_row(17, "BOS/CHoCH",    (smc_bos_bull or smc_choch_bull) ? "BULL ▲" : (smc_bos_bear or smc_choch_bear) ? "BEAR ▼" : "—", (smc_bos_bull or smc_choch_bull) ? c_green : (smc_bos_bear or smc_choch_bear) ? c_red : c_text_m)
    f_row(18, "SOS/MSS",      sosmssTxt, sosmssCol)
    f_row(19, "ORDER BLOCK",  obTxt, obCol)
    f_row(20, "MSNR",         msnrDshTxt, msnrDshCol)
    f_row(21, "CTR",          ctrDshTxt,  ctrDshCol)
    f_row(22, "LSDR",         lsdrTxt,    lsdrCol)
    f_row(23, "CPR",          cprTxt,     cprCol)
    f_row(24, "VWAP",         close > vwapVal ? "ABOVE ▲" : "BELOW ▼", close > vwapVal ? c_green : c_red)
    f_row(25, "BANK FLOW",    bankFlowTxt, bankFlowCol)
    f_row(26, "KILLZONE",     isKillzone ? (isLondonKZ ? "LONDON 🎯" : "NEW YORK 🎯") : "—", isKillzone ? c_green : c_text_m)
    f_row(27, "AIA/SNIPER",   aia_active ? "ACTIVE 💎" : "WAIT", aia_active ? c_green : c_text_m)
    f_hdr(28, "TRADE STATUS")
    f_row(29, "ENTRY",        na(entryPrice) ? "—" : str.tostring(entryPrice, format.mintick), #FFD700)
    f_row(30, "STOP LOSS",    na(exitPrice)  ? "—" : str.tostring(exitPrice, format.mintick),  c_red)
    f_row(31, "NEXT TP",      nextTPTxt, nextTPCol)
    f_row(32, "TGT STATUS",   tgtStr,    tgtCol)
    f_row(33, "PAD",          padDshTxt, padDshCol)
    f_row(34, "REV EXIT",     revDshTxt, revExitReason != "" ? c_orange : c_text_m)
    f_row(35, "SAFE EXIT",    safeExDshTxt, safeExReason != "" ? c_blue : c_text_m)
    f_hdr(36, "MACRO")
    f_row(37, "EVENT",        showMacroDash ? macroStatTxt : "HIDDEN", showMacroDash ? macroStatCol : c_text_m)
    f_row(38, "NEXT",         showMacroDash ? nextMacroTxt : "HIDDEN", showMacroDash ? (str.contains(nextMacroTxt,"NONE") ? c_text_m : c_blue) : c_text_m)
    f_row(39, "BIAS",         showMacroDash ? macroBias    : "HIDDEN", showMacroDash ? (macroBull ? c_green : macroBear ? c_red : c_text_m) : c_text_m)
    f_hdr(40, "SYSTEM HEALTH")
    f_row(41, "HEALTH",       healthTxt + " • " + str.tostring(healthPct) + "%", healthCol)
    f_row(42, "SESSION",      inSession ? "SESSION OK" : "SESSION OFF", inSession ? c_green : c_red)
    f_row(43, "INTERNALS",    useIntNow ? ((proxiesOkBuy or proxiesOkSell) ? "OK ✅" : "WEAK ⚠️") : "N/A", useIntNow ? ((proxiesOkBuy or proxiesOkSell) ? c_green : c_red) : c_text_m)
    f_hdr(44, "SMART MONEY ENGINE")
    f_row(45, "BUY SCORE",    str.tostring(scoreBuyF)  + "/15", scoreBuyF  >= minScore ? c_green : c_text_m)
    f_row(46, "SELL SCORE",   str.tostring(scoreSellF) + "/15", scoreSellF >= minScore ? c_red   : c_text_m)
    f_row(47, "FLOW",         buy_ratio_adv > 0.56 ? "BUY DOM" : buy_ratio_adv < 0.44 ? "SELL DOM" : "BALANCED", buy_ratio_adv > 0.56 ? c_green : buy_ratio_adv < 0.44 ? c_red : c_text_m)
    f_row(48, "MICRO DANGER", micro_danger ? "⚠ DANGER" : micro_doji ? "DOJI" : "CLEAR", micro_danger ? c_purple : micro_doji ? c_orange : c_green)
    f_row(49, "ACCU-LOCK",    accuActive ? "LOCKED 💎 " + accuDir : "IDLE", accuActive ? c_blue : c_text_m)
    f_row(50, "KILLZONE",     isKillzone ? (isLondonKZ ? "LONDON" : "NY") : "OFF-KZ", isKillzone ? c_green : c_text_m)

else if b_last and not showDashboard
    table.clear(fd, 0, 0, 1, 53)

// ═══════════════════════════════════════════════════════════
// RULES PANEL
// ═══════════════════════════════════════════════════════════
var table tbR = table.new(position.bottom_left, 1, 13, bgcolor=c_bg, border_width=1, frame_width=1)

if b_last and showRulesPanel
    table.clear(tbR, 0, 0, 0, 12)
    table.cell(tbR, 0, 0,  "SMC TM SUPREME v6.1 — RULES",       bgcolor=c_bg_hdr, text_color=c_text, text_size=d_sz, text_halign=text.align_center)
    table.cell(tbR, 0, 1,  "1) Entry on confirmed candle close only (non-repaint).",                                 bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 2,  "2) Structure: HTF EMA200 + LTF EMA stack + slope direction.",                           bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 3,  "3) MSNR: fresh S/R zone + rejection candle + trend alignment.",                         bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 4,  "4) CTR: impulse candle → mid retest → close confirmation.",                             bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 5,  "5) LSDR: liquidity sweep + displacement + reclaim / BOS / MSS.",                        bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 6,  "6) SMC: BOS/CHoCH (pivot-based), Order Blocks, FVG, EQH/EQL, CPR.",                    bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 7,  "7) Real Score: RAW (unbounded) + Normalised % + Grade A/B/C/D.",                        bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 8,  "8) No-Chase: blocks/penalises entries far from EMA/VWAP/MSNR or post-spike.",           bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 9,  "9) OB Proximity: penalises/blocks longs near supply, shorts near demand.",              bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 10, "10) Entry Type: LQ/REV/MSNR/CTR/PB/BD — shown in dashboard.",                          bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 11, "11) Rev Exit: fast pre-SL + after-TP gate. Flip on confirmed reversal.",                bgcolor=c_bg, text_color=c_text, text_size=d_sz, text_halign=text.align_left)
    table.cell(tbR, 0, 12, "STRUCTURE: " + msText + "  |  HEALTH: " + healthTxt, bgcolor=c_bg, text_color=msCol, text_size=d_sz, text_halign=text.align_center)
else if b_last and not showRulesPanel
    table.clear(tbR, 0, 0, 0, 12)

// ═══════════════════════════════════════════════════════════
// ALERT CONDITIONS
// ═══════════════════════════════════════════════════════════
alertcondition(buyEntryTrig,  "▲ BUY ENTRY",       "SMC TM Supreme v6 — BUY Entry")
alertcondition(sellEntryTrig, "▼ SELL ENTRY",       "SMC TM Supreme v6 — SELL Entry")
alertcondition(slTrig,        "❌ STOP LOSS",        "SMC TM Supreme v6 — SL Hit")
alertcondition(tp1Trig,       "T1 HIT",             "SMC TM Supreme v6 — T1")
alertcondition(tp2Trig,       "T2 HIT",             "SMC TM Supreme v6 — T2")
alertcondition(tp3Trig,       "T3 HIT",             "SMC TM Supreme v6 — T3")
alertcondition(tp4Trig,       "T4 HIT",             "SMC TM Supreme v6 — T4")
alertcondition(tp5Trig,       "T5 HIT",             "SMC TM Supreme v6 — T5")
alertcondition(revExitTrig,   "⛔ REVERSAL EXIT",   "SMC TM Supreme v6 — Rev Exit")
alertcondition(safeExitTrig,  "🛡 SAFE EXIT",        "SMC TM Supreme v6 — Safe Exit")
alertcondition(padBrkBuy,     "🛡 BUY PAD BREAK",   "SMC TM Supreme v6 — Buy Pad Break")
alertcondition(padBrkSell,    "🛡 SELL PAD BREAK",  "SMC TM Supreme v6 — Sell Pad Break")
alertcondition(smc_bos_bull,  "BOS Bullish",        "SMC TM Supreme v6 — Bullish BOS")
alertcondition(smc_bos_bear,  "BOS Bearish",        "SMC TM Supreme v6 — Bearish BOS")
alertcondition(smc_choch_bull,"CHoCH Bullish",      "SMC TM Supreme v6 — Bull CHoCH")
alertcondition(smc_choch_bear,"CHoCH Bearish",      "SMC TM Supreme v6 — Bear CHoCH")
alertcondition(sos_bull or mss_bull_s, "SOS/MSS Bull", "SMC TM Supreme v6 — Bull SOS/MSS")
alertcondition(sos_bear or mss_bear_s, "SOS/MSS Bear", "SMC TM Supreme v6 — Bear SOS/MSS")
alertcondition(micro_danger,  "⚠ MICRO DANGER",    "SMC TM Supreme v6 — Micro Danger near SL")
